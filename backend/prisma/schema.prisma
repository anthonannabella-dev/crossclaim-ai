generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String    @id @default(uuid())
  companyName         String
  contactName         String
  contactPhone        String
  contactEmail        String    @unique
  passwordHash        String
  emailVerified       Boolean   @default(false)
  status              String    @default("TRIAL")
  planTier            String    @default("ENTERPRISE")
  paymentCycle        String    @default("ANNUAL")
  trialStartAt        DateTime  @default(now())
  trialEndAt          DateTime
  subscribedAt        DateTime?
  expiresAt           DateTime?
  frozenAt            DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  wechatOpenId        String?
  wechatUnionId       String?
  wechatNickname      String?
  wechatAvatar        String?
  preferredPorts      String? // JSON: ["上海外高桥","宁波北仑","深圳盐田"] 客户常用口岸
  hsCodeRanges        String? // JSON: ["72","84","85"] 客户主营HS章节
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  subAccounts          SubAccount[]
  apiTokens            ApiToken[]
  documents            Document[]
  auditLogs            AuditLog[]
  payments             Payment[]
  timeGrants           TimeGrant[]
  legalConsents        LegalConsent[]
  cbamRecords          CBAMRecord[]
  webhookSubscriptions WebhookSubscription[]
  passwordResetTokens  PasswordResetToken[]
  tenantUsages         TenantUsage[]
  declarations         Declaration[]
  batchGroups          BatchGroup[]
  supplierInvoices     SupplierInvoice[]
  exportInvoices       ExportInvoice[]
  receiptRecords       ReceiptRecord[]
  recordArchives       RecordArchive[]
  taxRebateRecords     TaxRebateRecord[]
  // —— CrossClaim 追回领域（阶段 1 新增）——
  lossSignals          LossSignal[]
  recoveryCases        RecoveryCase[]
  recoveryLedger       RecoveryLedgerEntry[]
  channelAccounts      ChannelAccount[]
  importBatches        ImportBatch[]
}

model SubAccount {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  username     String
  passwordHash String
  role         String         @default("operator")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  declarations Declaration[]
  // —— CrossClaim 追回领域（阶段 1 新增）——
  ownedCases   RecoveryCase[] @relation("CaseOwner")
}

model ApiToken {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  appKey       String    @unique
  tokenHash    String
  name         String
  rateLimit    Int       @default(100)
  totalCalls   Int       @default(0)
  monthlyCalls Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  isActive     Boolean   @default(true)

  callLogs ApiCallLog[]
}

model ApiCallLog {
  id         String   @id @default(uuid())
  tokenId    String
  token      ApiToken @relation(fields: [tokenId], references: [id])
  endpoint   String
  method     String
  statusCode Int
  ip         String
  durationMs Int
  createdAt  DateTime @default(now())
}

model Payment {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  amount           Float
  planTier         String
  paymentCycle     String
  paymentMethod    String
  transactionId    String?
  status           String    @default("pending")
  invoiceRequested Boolean   @default(false)
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([tenantId])
  @@index([status])
}

model Document {
  id           String  @id @default(uuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  fileName     String
  fileType     String
  fileSize     Int
  minioPath    String
  ocrResult    String?
  category     String?
  status       String  @default("success") // success | failed
  errorMessage String?

  // 项目归档字段
  projectTag String? // 艺人/项目标签
  contractNo String? // 合同号

  // 校验结果（上传时自动校验，不再单独走AI审核Tab）
  auditPassed  Boolean? // 校验是否通过
  auditScore   Int? // 校验评分 0-100
  auditSummary String? // 校验摘要

  // 提运单归集
  billOfLading String? // 提单号，用于按票归集单据

  isEncrypted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([projectTag])
  @@index([contractNo])
  @@index([billOfLading])
}

model HSCode {
  id                  String   @id @default(uuid())
  code                String   @unique
  description         String
  unit                String?
  tariffRate          Float?
  exportRate          Float?
  vatRate             Float?
  exciseRate          Float?
  supervision         String?
  declarationElements String?
  category            String?
  updatedAt           DateTime @updatedAt
}

model RCEPRule {
  id              String    @id @default(uuid())
  productCode     String
  originCriteria  String
  tariffReduction Float?
  effectiveDate   DateTime?
  source          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FtaAgreement {
  id              String       @id @default(uuid())
  name            String
  shortName       String       @unique
  description     String?
  memberCountries String
  effectiveDate   DateTime
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  originRules     OriginRule[]
}

model OriginRule {
  id              String       @id @default(uuid())
  hsCode          String
  ftaAgreementId  String
  ftaAgreement    FtaAgreement @relation(fields: [ftaAgreementId], references: [id])
  ruleType        String
  ruleDetail      String?
  rvcThreshold    Float?
  tariffReduction Float?
  source          String?
  effectiveDate   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([ftaAgreementId, hsCode])
}

model CBAMRecord {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  hsCode            String
  productDesc       String?
  embeddedEmissions Float?
  carbonPrice       Float?
  estimatedCost     Float?
  emissionFactor    Float?
  carbonCost        Float?
  riskLevel         String
  calculatedAt      DateTime @default(now())

  @@index([tenantId])
  @@index([hsCode])
}

model PolicyAlert {
  id              String   @id @default(uuid())
  title           String
  content         String?
  summary         String?
  source          String
  publishDate     DateTime
  category        String
  portCode        String? // 直属海关代码: "shanghai"|"ningbo"|"shenzhen"|null(全国性)
  sourceType      String   @default("NATIONAL") // NATIONAL全国性 | LOCAL地方性
  hsCode          String?
  impactLevel     String?
  affectedHsCodes String?
  actionRequired  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([portCode])
  @@index([sourceType])
  @@index([category])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  action     String
  detail     String
  ip         String?
  operatorId String?
  createdAt  DateTime @default(now())

  entityType String? // 关联实体类型: bill_of_lading | declaration | batch_group ...
  entityId   String? // 关联实体ID(提单号/申报单ID 等), 供按票反查操作流水

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@index([tenantId, entityType, entityId])
}

model Admin {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  role         String      @default("admin")
  createdAt    DateTime    @default(now())
  timeGrants   TimeGrant[]
}

model TimeGrant {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  adminId       String
  admin         Admin    @relation(fields: [adminId], references: [id])
  daysGranted   Int
  monthsGranted Int      @default(0)
  reason        String?
  effectiveAt   DateTime @default(now())
  createdAt     DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LegalConsent {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  agreementType String
  version       String
  consentedAt   DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([tenantId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  url       String
  secret    String
  events    String // JSON array: ["declaration.build","cbam.high_risk"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id             String              @id @default(uuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id])
  eventType      String
  payload        String
  statusCode     Int?
  responseBody   String?
  durationMs     Int
  success        Boolean
  error          String?
  attempt        Int                 @default(1)
  createdAt      DateTime            @default(now())

  @@index([subscriptionId])
  @@index([success])
  @@index([createdAt])
}

model TenantUsage {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  resource  String // "ai_classify" | "document_upload" | "declaration_build" | "ocr" | "cbam" | "rcep" | "api_call"
  period    String // "daily" | "monthly"
  periodKey String // "2026-06-03" | "2026-06"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, resource, period, periodKey])
  @@index([tenantId])
  @@index([periodKey])
}

// ---- 报关单（草稿箱 + 历史 + 退单重报） ----
model Declaration {
  id            String  @id @default(uuid())
  tenantId      String
  declarationNo String? // 可选的报关单号
  status        String  @default("draft") // draft | submitted | rejected | resubmitted | completed

  // 申报模式相关
  customsMode     String  @default("normal") // normal | 9610 | 9710 | 9810 | 1210 | 1239
  supervisionCode String?
  taxMethod       String?

  // 基本字段（JSON 存储完整 declarationData + items）
  declarationJson String // JSON 序列化的 DeclarationData
  itemsJson       String // JSON 序列化的 DeclarationItem[]
  totalValue      Float    @default(0)
  currency        String?  @default("USD")
  billOfLading    String? // 提单号(从 declarationData 落列, 用于按票归集/查询, 免去扫全表+解析JSON)
  score           Int? // 合规评分
  preCheckPassed  Boolean? // 合规是否通过

  // 退单相关
  rejectionCode   String? // 退单代码
  rejectionReason String? // 退单原因
  rejectedAt      DateTime?
  resubmittedAt   DateTime?

  // 时间
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subAccount   SubAccount? @relation(fields: [subAccountId], references: [id])
  subAccountId String?

  // 退税关联
  supplierInvoices SupplierInvoice[]
  exportInvoices   ExportInvoice[]
  receiptRecords   ReceiptRecord[]
  recordArchives   RecordArchive[]
  taxRebateRecords TaxRebateRecord[]

  @@index([tenantId, status])
  @@index([tenantId, customsMode])
  @@index([tenantId, createdAt])
  @@index([tenantId, billOfLading])
}

// ---- 退税补充模块（方案A）----

// 供应商发票核验
model SupplierInvoice {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  declarationId String? // 关联报关单ID
  declaration   Declaration? @relation(fields: [declarationId], references: [id])

  // 发票信息
  invoiceNo     String // 发票号码
  invoiceDate   DateTime? // 开票日期
  supplierName  String? // 供应商名称
  supplierTaxId String? // 供应商税号

  // OCR 提取的明细
  ocrResult String? // OCR 原始结果 JSON
  itemsJson String? // 发票明细 JSON: [{name, spec, quantity, unit, unitPrice, amount}]

  // 三要素比对结果
  matchStatus String  @default("pending") // pending | matched | mismatch
  matchScore  Int? // 匹配评分 0-100
  matchDetail String? // 比对详情 JSON

  // 文档关联
  docId String? // 对应Document表ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([declarationId])
  @@index([invoiceNo])
}

// 出口发票
model ExportInvoice {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  declarationId String? // 关联报关单
  declaration   Declaration? @relation(fields: [declarationId], references: [id])

  invoiceNo   String // 发票号码
  invoiceDate DateTime // 开票日期（报关当月）
  totalAmount Float // 总金额（CNY）
  currency    String   @default("CNY")
  taxRate     String   @default("0%") // 0% 零税率
  status      String   @default("draft") // draft | issued | cancelled

  // 关联销售订单/合同
  contractNo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([declarationId])
}

// 收汇记录
model ReceiptRecord {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  declarationId String? // 关联报关单
  declaration   Declaration? @relation(fields: [declarationId], references: [id])

  receiptNo     String // 收汇凭证号/银行回单号
  receiptDate   DateTime // 收汇日期
  receiptAmount Float // 收汇金额
  currency      String   @default("USD")
  exchangeRate  Float? // 当时汇率
  amountCNY     Float? // 折合人民币

  bankName  String? // 银行名称
  payerName String? // 付款方名称

  // 状态：未超期 | 超期210天 | 已做延期
  overdueStatus String @default("normal") // normal | overdue | extended

  docId String? // 银行回单文件ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([declarationId])
}

// 备案单证组（退税核查用）
model RecordArchive {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  declarationId String? // 关联报关单
  declaration   Declaration? @relation(fields: [declarationId], references: [id])

  name   String // 单证组名称
  status String @default("incomplete") // incomplete | complete | archived

  // 关键单证是否齐全
  hasContract    Boolean @default(false) // 购销合同
  hasTransport   Boolean @default(false) // 运输单据
  hasDeclaration Boolean @default(false) // 报关单
  hasInvoice     Boolean @default(false) // 发票
  hasPackingList Boolean @default(false) // 装箱单
  hasReceipt     Boolean @default(false) // 收汇凭证

  // 保存期限
  archiveDate DateTime? // 归档日期
  expiryDate  DateTime? // 保存到期日（归档+10年）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([declarationId])
}

// 退税申报记录（替代原来的审计日志追踪）
model TaxRebateRecord {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  declarationId String? // 关联报关单
  declaration   Declaration? @relation(fields: [declarationId], references: [id])

  // 退税基本信息
  hsCode        String
  description   String
  quantity      Float
  unit          String
  fobAmountUSD  Float
  fobAmountCNY  Float
  exportRate    Float // 退税率 %
  vatRate       Float // 增值税率 %
  rebateAmount  Float // 应退税额
  nonRefundable Float // 不退税额

  // 状态机
  status String @default("calculated") // calculated | invoice_matched | receipt_confirmed | documents_ready | submitted | under_review | refunded | rejected

  // 关联
  supplierInvoiceId String? // 关联的供应商发票
  exportInvoiceId   String? // 关联的出口发票
  receiptId         String? // 关联的收汇记录
  archiveId         String? // 关联的备案单证组

  // 备注
  note String?

  // 时间线
  calculatedAt DateTime  @default(now())
  submittedAt  DateTime?
  reviewedAt   DateTime?
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([declarationId])
  @@index([status])
}

// 批量识别自动归档 — 提运单归集组
model BatchGroup {
  id                    String    @id @default(uuid())
  tenantId              String
  billOfLading          String // 提运单号
  projectTag            String? // 项目标签
  status                String    @default("pending") // pending | ocr_running | ocr_done | ai_checking | ai_done | auto_filling | auto_filled | pending_review | pre_checking | checked | declaring | declared | customs_review | released | completed | rejected | pre_check_failed | error
  docCount              Int       @default(0)
  ocrCount              Int       @default(0)
  ocrSuccess            Int       @default(0)
  aiSummary             String? // JSON: { classify, tariff, diagnose }
  archivedAt            DateTime?
  xmlPath               String? // 导出 XML 文件名(申报登记用)
  declarationXml        String? // 申报报文快照(导出申报当时的原始 XML,供调档/稽查留痕)
  declarationSnapshotAt DateTime? // 报文快照生成时间
  errorMsg              String?
  declarationId         String? // 关联的自动填制申报单
  preCheckResult        String? // JSON: PreCheckResult
  preCheckPassed        Boolean?
  declaredAt            DateTime?
  taxRebateValue        Float?
  taxRebateStatus       String?
  taxRebateEstimatedAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // 关联
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, billOfLading])
  @@index([tenantId, projectTag])
}

// 组内 AI 校验结果
model GroupValidation {
  id          String    @id @default(uuid())
  groupId     String
  docId       String?
  checkType   String // classify | tariff | diagnose
  status      String    @default("pending") // pending | running | passed | warning | error
  resultJson  String? // AI 返回的详细结果
  summary     String? // 摘要
  score       Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([groupId])
  @@index([groupId, checkType])
}

// 证件台账（监管证件/许可证），用于到期预警与证件类风险
model LicenseRecord {
  id               String    @id @default(uuid())
  tenantId         String
  licenseType      String // 证件类型名称(如 进出口许可证/3C/卫生证书/濒危种证)
  licenseCode      String? // 监管证件代码(如 "1" 进口许可证, "4" 进口药品...)
  licenseNo        String // 证件编号
  holder           String? // 持证单位/相关方
  relatedHsCodes   String? // 适用HS(逗号分隔)
  issuingAuthority String? // 发证机关
  issueDate        DateTime?
  expiryDate       DateTime?
  status           String    @default("active") // active | expired | revoked
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, expiryDate])
}

// ============================================================
// CrossClaim AI · 追回领域模型（阶段 1）
// 纯增量：只新增枚举与模型 + Tenant/SubAccount 的反向关系
// ============================================================

enum RecoveryChannel {
  AMAZON
  UPS
  FEDEX
  FREIGHT
  INSURANCE
  CUSTOMS
  OTHER
}

enum SignalStatus {
  NEW
  TRIAGED
  PROMOTED
  DISMISSED
}

enum CaseStatus {
  OPEN
  COLLECTING
  EVIDENCE_READY
  SUBMITTED
  WAITING
  APPEALED
  APPROVED
  RECOVERED
  REJECTED
  ABANDONED
}

enum ClaimRound {
  FIRST
  APPEAL
  ESCALATION
}

enum ClaimResponseType {
  APPROVED
  PARTIAL
  REJECTED
  NO_RESPONSE
}

enum EvidenceKind {
  CONTRACT
  RATE_CARD
  INVOICE
  POD
  TRACKING
  EMAIL
  BILL
  CUSTOMS_DOC
  OTHER
}

enum LedgerEntryType {
  DISCOVERED
  RECOVERED
  COMMISSION
  ADJUSTED
  WRITTEN_OFF
  REVERSAL
}

enum ConfirmationSource {
  MANUAL
  BANK_STATEMENT
  CHANNEL_RECEIPT
}

enum ImportStatus {
  PENDING
  PARSING
  IMPORTED
  PARTIAL
  FAILED
}

/// 漏损信号：一条「这里可能少收了钱」的线索
model LossSignal {
  id             String          @id @default(uuid())
  tenantId       String
  channel        RecoveryChannel
  signalType     String
  detectedAt     DateTime        @default(now())
  sourceRef      String?
  sourceFileId   String?
  amountExpected Decimal?        @db.Decimal(18, 4)
  amountActual   Decimal?        @db.Decimal(18, 4)
  currency       String          @default("USD")
  confidence     Float?
  status         SignalStatus    @default(NEW)
  dismissNote    String?
  rawPayload     Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cases  CaseSignal[]

  @@index([tenantId, status])
  @@index([tenantId, channel, detectedAt])
}

/// 追回案件：由信号升级而来
model RecoveryCase {
  id                 String          @id @default(uuid())
  tenantId           String
  caseNo             String
  title              String
  primaryChannel     RecoveryChannel
  status             CaseStatus      @default(OPEN)
  claimedAmount      Decimal?        @db.Decimal(18, 4)
  recoveredAmount    Decimal         @default(0) @db.Decimal(18, 4)
  currency           String          @default("USD")
  slaDueAt           DateTime?
  openedAt           DateTime        @default(now())
  closedAt           DateTime?
  temporalWorkflowId String?
  temporalRunId      String?
  nextActionAt       DateTime?
  aiAssessment       Json?
  ownerId            String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner    SubAccount?           @relation("CaseOwner", fields: [ownerId], references: [id])
  signals  CaseSignal[]
  claims   Claim[]
  evidence Evidence[]
  ledger   RecoveryLedgerEntry[]

  @@unique([tenantId, caseNo])
  @@index([tenantId, status])
  @@index([tenantId, nextActionAt])
  @@index([temporalWorkflowId])
}

/// 案件 ↔ 信号 多对多
model CaseSignal {
  caseId   String
  signalId String
  note     String?

  case   RecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  signal LossSignal   @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@id([caseId, signalId])
}

/// 索赔/上诉动作：上诉 = round=APPEAL 且 parentClaimId 指向上一轮
model Claim {
  id             String             @id @default(uuid())
  caseId         String
  channel        RecoveryChannel
  round          ClaimRound         @default(FIRST)
  parentClaimId  String?
  submittedAt    DateTime?
  submittedBy    String?
  externalRef    String?
  expectedAmount Decimal?           @db.Decimal(18, 4)
  currency       String             @default("USD")
  dueAt          DateTime?
  responseAt     DateTime?
  responseType   ClaimResponseType?
  responseAmount Decimal?           @db.Decimal(18, 4)
  responseNote   String?
  attachmentKey  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  case   RecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  parent Claim?       @relation("ClaimChain", fields: [parentClaimId], references: [id])
  child  Claim[]      @relation("ClaimChain")

  @@index([caseId, round])
  @@index([dueAt, responseAt])
}

/// 证据：文件本体在对象存储，这里只存元数据与指纹
model Evidence {
  id         String       @id @default(uuid())
  caseId     String
  kind       EvidenceKind
  fileKey    String
  fileName   String
  mimeType   String?
  size       Int?
  sha256     String?
  source     String?
  note       String?
  uploadedBy String?
  createdAt  DateTime     @default(now())

  case RecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, kind])
  @@index([sha256])
}

/// 追回账本：只增不改，纠错靠反向分录
model RecoveryLedgerEntry {
  id                 String              @id @default(uuid())
  tenantId           String
  caseId             String?
  entryType          LedgerEntryType
  amount             Decimal             @db.Decimal(18, 4)
  currency           String              @default("USD")
  occurredAt         DateTime            @default(now())
  counterparty       String?
  reference          String?
  confirmationSource ConfirmationSource?
  confirmedBy        String?
  confirmedAt        DateTime?
  voidsEntryId       String?
  voidedAt           DateTime?
  voidedBy           String?
  voidReason         String?
  createdBy          String?
  createdAt          DateTime            @default(now())

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   RecoveryCase?         @relation(fields: [caseId], references: [id])
  voids  RecoveryLedgerEntry?  @relation("LedgerVoids", fields: [voidsEntryId], references: [id])
  voided RecoveryLedgerEntry[] @relation("LedgerVoids")

  @@index([tenantId, occurredAt])
  @@index([tenantId, entryType])
  @@index([caseId])
}

/// 渠道账号：只存凭据指针，不存明文密钥
model ChannelAccount {
  id             String          @id @default(uuid())
  tenantId       String
  channel        RecoveryChannel
  label          String
  credentialsRef String?
  status         String          @default("ACTIVE")
  lastSyncAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, label])
}

/// 导入批次：CSV/Excel 每次导入留痕
model ImportBatch {
  id          String          @id @default(uuid())
  tenantId    String
  channel     RecoveryChannel
  fileName    String
  fileType    String
  status      ImportStatus    @default(PENDING)
  rowsTotal   Int             @default(0)
  rowsOk      Int             @default(0)
  rowsFailed  Int             @default(0)
  errorReport Json?
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  createdBy   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel, startedAt])
}

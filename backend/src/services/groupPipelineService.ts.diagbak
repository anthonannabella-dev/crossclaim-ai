
import prisma from '../config/database';
import { logger } from '../config/logger';
import { env } from '../config/env';

export type GroupStatus = 'pending' | 'ocr_running' | 'ocr_done' | 'ai_checking' | 'ai_done' | 'auto_filling' | 'auto_filled' | 'pending_review' | 'pre_checking' | 'checked' | 'declaring' | 'declared' | 'customs_review' | 'released' | 'completed' | 'rejected' | 'pre_check_failed' | 'error';
export type ValidationType = 'classify' | 'tariff' | 'diagnose';

// ============================================================
// 异步步骤调度: 持久化队列(BullMQ)启用时走队列, 否则回落 process.nextTick。
// dispatchPipelineStep 供队列 worker 调用; schedule 供流水线内部触发。
// ============================================================
export type PipelineStep = 'ocr' | 'ai' | 'autofill';

const STEP_LABEL: Record<PipelineStep, string> = { ocr: 'OCR', ai: 'AI校验', autofill: '自动填制' };

// 按步骤分发到具体执行函数(失败抛出, 由调用方/worker 处理重试与置错)
export async function dispatchPipelineStep(step: PipelineStep, groupId: string): Promise<void> {
  if (step === 'ocr') return runGroupOCR(groupId);
  if (step === 'ai') return runGroupAIChecks(groupId);
  if (step === 'autofill') return autoFillDeclaration(groupId);
  throw new Error('未知流水线步骤: ' + step);
}

// 内联执行(原 process.nextTick 行为): 失败则把分组置 error
function runInline(step: PipelineStep, groupId: string): void {
  process.nextTick(async () => {
    try { await dispatchPipelineStep(step, groupId); }
    catch (err: any) {
      logger.error('[Pipeline] %s 失败 group=%s: %s', STEP_LABEL[step], groupId, err.message);
      await prisma.batchGroup.update({
        where: { id: groupId },
        data: { status: 'error', errorMsg: STEP_LABEL[step] + '失败: ' + err.message },
      }).catch(() => {});
    }
  });
}

// 调度一个步骤: 队列启用则入队(失败回落内联), 否则直接内联。动态导入打破循环依赖。
function schedule(step: PipelineStep, groupId: string): void {
  import('./queue/pipelineQueue')
    .then(async (q) => {
      if (q.isQueueEnabled()) await q.enqueuePipelineJob(step, groupId);
      else runInline(step, groupId);
    })
    .catch((err: any) => {
      logger.error('[Pipeline] 入队失败, 回落内联执行: %s', err?.message);
      runInline(step, groupId);
    });
}

// 从单证 OCR 文本探测跨境电商监管方式 + 抽取三单(订单/支付/物流)+平台/B2B单号
// 让「制单」环节把电商信息搬进报关单数据，从而流入预检(ECM规则)与报文(EcommerceInfo段)
export function detectEcommerceFromDocs(
  docs: { ocrResult?: string | null }[]
): {
  customsMode?: string; supervisionCode?: string;
  orderNo?: string; paymentNo?: string; logisticsNo?: string;
  ecommercePlatform?: string; b2bOrderNo?: string;
} {
  const text = (docs || []).map((d) => d?.ocrResult || '').join('\n');
  const grab = (re: RegExp) => { const m = text.match(re); return m && m[1] ? m[1].trim() : undefined; };
  const orderNo = grab(/(?:订单号|关联订单|Order\s*No)[：:\s]*([A-Z0-9][A-Z0-9\-]{3,39})/i);
  const paymentNo = grab(/(?:支付单号|支付流水号|Payment\s*No|Transaction\s*No|交易号)[：:\s]*([A-Z0-9][A-Z0-9\-]{3,39})/i);
  const logisticsNo = grab(/(?:物流单号|运单号|快递单号|Logistics\s*No|Waybill\s*No|Tracking\s*No)[：:\s]*([A-Z0-9][A-Z0-9\-]{3,39})/i);
  const ecommercePlatform = grab(/(?:电商平台|Platform)\s*[：:]\s*([^\r\n]{2,40})/i);
  const b2bOrderNo = grab(/(?:B2B出口单号|跨境电商B2B出口单号|B2B\s*Order\s*No)[：:\s]*([A-Z0-9][A-Z0-9\-]{3,39})/i);
  let mode: string | undefined;
  const tok = text.match(/(?:监管方式|贸易方式|Supervision)[：:\s]*(9610|9710|9810|1210|1239)/i) || text.match(/\b(9610|9710|9810|1210|1239)\b/);
  if (tok) mode = tok[1];
  else if (orderNo && paymentNo && logisticsNo) mode = '9610'; // 三单齐备 → 零售出口
  else if (b2bOrderNo) mode = '9710';
  if (!mode) return {};
  return { customsMode: mode, supervisionCode: mode, orderNo, paymentNo, logisticsNo, ecommercePlatform, b2bOrderNo };
}

// 1. 创建/更新分组
export async function ensureBatchGroup(
  tenantId: string,
  billOfLading: string,
  docId: string,
  projectTag?: string,
): Promise<string> {
  let group = await prisma.batchGroup.findFirst({
    where: { tenantId, billOfLading, status: { not: 'archived' } },
  });
  if (group) {
    await prisma.batchGroup.update({
      where: { id: group.id },
      data: { docCount: { increment: 1 }, projectTag: projectTag || group.projectTag },
    });
    return group.id;
  }
  group = await prisma.batchGroup.create({
    data: { tenantId, billOfLading, projectTag: projectTag || null, status: 'pending', docCount: 1 },
  });
  return group.id;
}

// 2. 触发整组 OCR
export async function triggerGroupOCR(groupId: string): Promise<void> {
  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'ocr_running' },
  });
  schedule('ocr', groupId);
}

// 3. 执行整组 OCR
async function runGroupOCR(groupId: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) return;
  const docs = await prisma.document.findMany({
    where: { tenantId: group.tenantId, billOfLading: group.billOfLading, ocrResult: null },
  });
  let successCount = 0;
  for (const doc of docs) {
    try { await processSingleDocOCR(doc); successCount++; }
    catch (err: any) { logger.error('[Pipeline] OCR doc failed:', doc.id, err.message); }
  }
  const totalDocs = await prisma.document.count({
    where: { tenantId: group.tenantId, billOfLading: group.billOfLading },
  });
  const ocrDocs = await prisma.document.count({
    where: { tenantId: group.tenantId, billOfLading: group.billOfLading, ocrResult: { not: null } },
  });
  await prisma.batchGroup.update({
    where: { id: groupId },
    data: {
      ocrCount: totalDocs,
      ocrSuccess: ocrDocs,
      status: ocrDocs > 0 ? 'ocr_done' : 'error',
      errorMsg: ocrDocs === 0 ? '全部文档OCR失败' : undefined,
    },
  });
  if (ocrDocs > 0) { await triggerGroupAIChecks(groupId); }
}

// 4. 单文档 OCR
async function processSingleDocOCR(doc: any): Promise<void> {
  const { runDocumentOCR } = await import('./documentAuditService');
  const { getMinio, tenantBucket } = await import('../config/minio');
  const minio = getMinio();
  if (!minio || !doc.minioPath) {
    await prisma.document.update({
      where: { id: doc.id },
      data: { status: 'failed', errorMessage: '文件存储不可用' },
    });
    return;
  }
  try {
    const stream = await minio.getObject(tenantBucket(doc.tenantId), doc.minioPath);
    const chunks: Buffer[] = [];
    for await (const chunk of stream) {
      chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
    }
    const buffer = Buffer.concat(chunks);
    const ocrText = await runDocumentOCR(buffer, doc.fileName);
    await prisma.document.update({
      where: { id: doc.id },
      data: { ocrResult: ocrText, status: 'success', category: (await import('./documentAuditService')).detectDocType(ocrText, doc.fileName) },
    });
  } catch (err: any) {
    await prisma.document.update({
      where: { id: doc.id },
      data: { status: 'failed', errorMessage: err.message },
    });
  }
}

// 4b. 单文档 OCR + 自动归类入口(无提运单号上传时直接调用，不建分组/不制单)
export async function ocrAndClassifyDocument(docId: string): Promise<void> {
  const d = await prisma.document.findUnique({ where: { id: docId } });
  if (d) await processSingleDocOCR(d);
}

// 5. 触发 AI 校验
export async function triggerGroupAIChecks(groupId: string): Promise<void> {
  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'ai_checking' },
  });
  schedule('ai', groupId);
}

// 6. 执行 AI 三项校验
async function runGroupAIChecks(groupId: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) return;
  const docs = await prisma.document.findMany({
    where: { tenantId: group.tenantId, billOfLading: group.billOfLading, ocrResult: { not: null } },
  });
  if (docs.length === 0) return;

  const texts: string[] = [];
  for (const d of docs) {
    texts.push('[' + d.fileName + ']\n' + (d.ocrResult || ''));
  }
  const combinedText = texts.join('\n---\n');

  const checkTypes = ['classify', 'tariff', 'diagnose'];
  const results: Record<string, any> = {};

  for (const checkType of checkTypes) {
    const validation = await prisma.groupValidation.create({
      data: { groupId, checkType, status: 'running', startedAt: new Date() },
    });
    try {
      let result: any;
      if (checkType === 'classify') result = await checkAiClassify(combinedText, group.billOfLading);
      else if (checkType === 'tariff') result = await checkAiTariff(combinedText, group.billOfLading);
      else result = await checkAiDiagnose(combinedText, group.billOfLading);
      results[checkType] = result;
      await prisma.groupValidation.update({
        where: { id: validation.id },
        data: {
          status: result.passed ? 'passed' : 'warning',
          resultJson: JSON.stringify(result),
          summary: result.summary || result.message || '',
          score: result.score || 100,
          completedAt: new Date(),
        },
      });
    } catch (err: any) {
      await prisma.groupValidation.update({
        where: { id: validation.id },
        data: { status: 'error', resultJson: JSON.stringify({ error: err.message }), summary: err.message, completedAt: new Date() },
      });
    }
  }

  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'ai_done', aiSummary: JSON.stringify(results) },
  });

    // AI 校验完成 → 自动进入自动填制(startAutoFill 自带 ai_done 守卫，安全幂等)
    await startAutoFill(groupId);
  }

// 7-9. AI 辅助函数
async function checkAiClassify(ocrText: string, billOfLading: string): Promise<any> {
  const config = env();
  if (!config.DEEPSEEK_API_KEY) {
    return { passed: false, summary: 'DeepSeek未配置，跳过AI归类', score: 0 };
  }
  const prompt = '你是一个专业的海关归类AI助手。请分析以下单据内容（发票/箱单/报关单），'
    + '为这批货物推荐最合适的HS编码（前6位）并说明理由。\n\n'
    + '提运单号：' + billOfLading + '\n\n单据内容：\n'
    + ocrText.slice(0, 8000)
    + '\n\n请返回JSON格式：{"recommendedHsCode":"XXXXXX","description":"...","confidence":"high/medium/low","reason":"...","passed":true/false,"score":0-100,"summary":"..."}';
  try {
    const { completionJSON } = await import('./ai/deepseek');
    return await completionJSON(prompt, { temperature: 0.2, maxTokens: 1000 }) || { passed: true, summary: 'AI归类完成', score: 100 };
  } catch (err: any) {
    return { passed: false, summary: 'AI归类异常: ' + err.message, score: 0 };
  }
}

async function checkAiTariff(ocrText: string, billOfLading: string): Promise<any> {
  const config = env();
  if (!config.DEEPSEEK_API_KEY) {
    return { passed: false, summary: 'DeepSeek未配置，跳过税率校验', score: 0 };
  }
  const prompt = '你是一个关税税率校验AI助手。请分析以下单据，检查申报金额、数量与HS编码对应的税率是否匹配。\n\n'
    + '提运单号：' + billOfLading + '\n\n单据内容：\n'
    + ocrText.slice(0, 8000)
    + '\n\n请返回JSON格式：{"estimatedValue":"...","estimatedTariff":"...","issues":[...],"passed":true/false,"score":0-100,"summary":"..."}';
  try {
    const { completionJSON } = await import('./ai/deepseek');
    return await completionJSON(prompt, { temperature: 0.2, maxTokens: 1000 }) || { passed: true, summary: '税率校验完成', score: 100 };
  } catch (err: any) {
    return { passed: false, summary: '税率校验异常: ' + err.message, score: 0 };
  }
}

async function checkAiDiagnose(ocrText: string, billOfLading: string): Promise<any> {
  const config = env();
  if (!config.DEEPSEEK_API_KEY) {
    return { passed: false, summary: 'DeepSeek未配置，跳过退单诊断', score: 0 };
  }
  const prompt = '你是一个退单风险诊断AI助手。请分析以下单据，检查是否存在可能导致海关退单的问题。\n\n'
    + '提运单号：' + billOfLading + '\n\n单据内容：\n'
    + ocrText.slice(0, 8000)
    + '\n\n请返回JSON格式：{"riskLevel":"low/medium/high","riskFactors":[...],"suggestions":[...],"passed":true/false,"score":0-100,"summary":"..."}';
  try {
    const { completionJSON } = await import('./ai/deepseek');
    return await completionJSON(prompt, { temperature: 0.2, maxTokens: 1000 }) || { passed: true, summary: '退单诊断完成', score: 100 };
  } catch (err: any) {
    return { passed: false, summary: '退单诊断异常: ' + err.message, score: 0 };
  }
}

// ============== 自动化流水线 v2 ==============
// 流程: AI校验完成 → 自动填制 → 人工复核 → 合规预检 → 电子申报 → 海关回执 → 放行 → 结关
// 退税已移至独立的退税管理模块，不再作为流水线步骤

/**
 * 启动自动填制（从 ai_done 触发，替代旧的 archiveGroup）
 */
export async function startAutoFill(groupId: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group || group.status !== 'ai_done') {
    logger.warn('[Pipeline] startAutoFill: invalid status for group:', groupId);
    return;
  }

  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'auto_filling' },
  });

  schedule('autofill', groupId);
}

/**
 * 执行自动填制 — 填完后进入 pending_review 等待人工审核
 */
async function autoFillDeclaration(groupId: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) return;

  // 解析 AI 校验结果
  let recommendedHsCode = '';
  let itemDescription = '';
  let totalEstimatedValue = 0;

  if (group.aiSummary) {
    try {
      const aiSummary = JSON.parse(group.aiSummary);
      const classify = aiSummary.classify;
      if (classify && classify.recommendedHsCode) {
        recommendedHsCode = classify.recommendedHsCode;
        itemDescription = classify.description || '';
      }
      const tariff = aiSummary.tariff;
      if (tariff && tariff.estimatedValue) {
        totalEstimatedValue = parseFloat(tariff.estimatedValue) || 0;
      }
    } catch (e) { /* 解析失败不影响 */ }
  }

  // 从文档中尝试提取 HS 编码
  if (!recommendedHsCode) {
    const docs = await prisma.document.findMany({
      where: { tenantId: group.tenantId, billOfLading: group.billOfLading },
    });
    for (const doc of docs) {
      if (doc.ocrResult && doc.ocrResult.includes('HS')) {
        const match = doc.ocrResult.match(/HS\s*[Cc]ode[:\s]*(\d{4,10})/);
        if (match) { recommendedHsCode = match[1]; break; }
      }
    }
  }

  // —— 用 AI 结构化提取补全真实商品明细(数量/单价/品名/原产国),替代写死的占位值 ——
  let aiItems: any[] = [];
  try {
    const { extractWithAI } = await import('./ocrParser');
    const aiDocs = await prisma.document.findMany({
      where: { tenantId: group.tenantId, billOfLading: group.billOfLading, ocrResult: { not: null } },
    });
    const combinedText = aiDocs.map((d: any) => d.ocrResult || '').join('\n');
    if (combinedText.trim()) {
      const extracted = await extractWithAI(combinedText, 'declaration');
      if (extracted && Array.isArray((extracted as any).items)) {
        aiItems = (extracted as any).items.filter((it: any) => it && (it.hsCode || it.description));
      }
    }
  } catch (e) { /* AI 提取失败则回退占位逻辑,不影响主流程 */ }
  if (!recommendedHsCode && aiItems.length && aiItems[0].hsCode) {
    recommendedHsCode = String(aiItems[0].hsCode).replace(/\D/g, '');
  }
  if (!recommendedHsCode) {
    await prisma.batchGroup.update({
      where: { id: groupId },
      data: { status: 'error', errorMsg: '自动填制失败: 无法从单证中识别HS编码，请手动填写申报' },
    });
    return;
  }

  const { buildDeclaration } = await import('./declarationBuilder');
  const { saveDraft } = await import('./declarationService');

  // 探测跨境电商监管方式 + 三单(让电商信息进入报关单，而非永远填成一般贸易)
  const allDocs = await prisma.document.findMany({
    where: { tenantId: group.tenantId, billOfLading: group.billOfLading },
  });
  const ecom = detectEcommerceFromDocs(allDocs);

  try {
    // 用 buildDeclaration 做富化:按 HS 查询商品描述/法定计量单位、MFN 税率、最优 FTA 税率与原产地规则,
    // 并把探测到的跨境电商监管方式+三单一并带入,使其产出的 declaration 直接携带电商字段(流向预检与报文)。
    // 关键修复:以往这里只取手工拼装的精简数据落库,buildDeclaration 的富化结果被整体丢弃。
    const built = await buildDeclaration(group.tenantId, {
      hsCodes: [recommendedHsCode],
      itemDetails: (aiItems.length ? aiItems : [{}]).map((it: any) => ({
        hsCode: String(it.hsCode || recommendedHsCode || '').replace(/\D/g, ''),
        quantity: Number(it.quantity) > 0 ? Number(it.quantity) : 1,
        unitPrice: Number(it.unitPrice) > 0 ? Number(it.unitPrice) : (totalEstimatedValue || 0),
        description: it.description || itemDescription || '待确认商品',
        originCountry: it.originCountry || '中国',
        ...(it.unit ? { unit: it.unit } : {}),
        ...(Number(it.totalPrice) > 0 ? { totalPrice: Number(it.totalPrice) } : {}),
      })),
      transportMode: '',
      vesselFlight: group.billOfLading,
      portOfLoading: '',
      portOfDischarge: '',
      portOfEntry: '',
      tradeTerms: 'FOB',
      currency: 'USD',
      customsMode: ecom.customsMode || 'normal',
      // 跨境电商三单/平台(探测到电商模式时带入)
      ...(ecom.customsMode ? {
        orderNo: ecom.orderNo,
        paymentNo: ecom.paymentNo,
        logisticsNo: ecom.logisticsNo,
        ecommercePlatform: ecom.ecommercePlatform,
        b2bOrderNo: ecom.b2bOrderNo,
      } : {}),
    });

    // 以富化后的 declaration 为落库基准,仅叠加自动填制的上下文:
    // 申报单位标记、提运单号、以及监管方式代码(buildDeclaration 只设 customsMode,
    // 报文 TradeMode 取 supervisionCode,故此处补齐)。consignee/consignor 仍留空待人工复核。
    const declarationData: any = {
      ...built.declaration,
      declarant: '自动申报',
      billOfLading: group.billOfLading,
      supervisionCode: ecom.supervisionCode || built.declaration.supervisionCode,
    };

    // 复用 buildDeclaration 已算出的合规预检结果写入草稿(分值/是否通过/首个错误→退单原因)
    const saved = await saveDraft(group.tenantId, declarationData, built.preCheck);

      let pc: any = built && (built as any).preCheck;
      if (!pc || !Array.isArray(pc.issues)) {
        const { runPreCheck } = await import('./declarationBuilder');
        pc = runPreCheck(declarationData, (declarationData as any).items || (built && (built as any).items) || []);
      }
      const pcErr = (pc.issues || []).some((i: any) => i.severity === 'error');
      await prisma.batchGroup.update({
        where: { id: groupId },
        data: {
          status: pcErr ? 'pending_review' : 'checked',
          declarationId: saved.id,
          preCheckResult: JSON.stringify(pc),
          preCheckPassed: !pcErr,
          errorMsg: pcErr ? '自动预检发现待补全要素，请在复核界面修正后点复核通过' : null,
        },
      });

      logger.info('[Pipeline] Auto fill + auto pre-check done group:%s passed:%s', groupId, !pcErr);

  } catch (err: any) {
    logger.error('[Pipeline] Auto fill error:', err.message);
    await prisma.batchGroup.update({
      where: { id: groupId },
      data: { status: 'error', errorMsg: '自动填制失败: ' + err.message },
    });
  }
}

// ============================================================
// 人工复核 + 合规预检 + 申报
// ============================================================

/**
 * 人工复核通过 → 合规预检 → 申报
 */
export async function approveReview(
  groupId: string,
  patch?: { header?: Record<string, any>; items?: any[] },
): Promise<{ passed: boolean; score: number; issues: any[] }> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) throw new Error('分组不存在');
  if (group.status !== 'pending_review') throw new Error('当前状态不可复核');

  const declarationId = group.declarationId;
  if (!declarationId) throw new Error('未关联报关单');

  const { getDeclarationDetail } = await import('./declarationService');
  const { runPreCheck } = await import('./declarationBuilder');

  // 执行合规预检
  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'pre_checking' },
  });

  const detail = await getDeclarationDetail(group.tenantId, declarationId);
  if (!detail) throw new Error('报关单不存在');

  const declarationData = JSON.parse(detail.declarationJson);
  let items = JSON.parse(detail.itemsJson || '[]');

  // 复核补填: 合并报关员在复核界面填写/修正的要素(境内收发货人/规格型号/运保杂费/法定计量单位等)
  if (patch) {
    if (patch.header) Object.assign(declarationData, patch.header);
    if (Array.isArray(patch.items) && patch.items.length > 0) {
      items = items.map((it: any, idx: number) => ({ ...it, ...(patch.items![idx] || {}) }));
      // 补丁项数多于现有项时, 追加
      for (let i = items.length; i < patch.items.length; i++) items.push(patch.items[i]);
    }
    declarationData.items = items;
    // 回写持久化, 保证导出XML与预检使用同一份数据
    await prisma.declaration.update({
      where: { id: declarationId },
      data: {
        declarationJson: JSON.stringify(declarationData),
        itemsJson: JSON.stringify(items),
        totalValue: declarationData.totalValue ?? detail.totalValue ?? 0,
      },
    }).catch(() => {});
  }

  const preCheckResult = runPreCheck(declarationData, items);
  const hasErrors = preCheckResult.issues.some(i => i.severity === 'error');

  if (hasErrors) {
    await prisma.batchGroup.update({
      where: { id: groupId },
      data: {
        status: 'pre_check_failed',
        preCheckResult: JSON.stringify(preCheckResult),
        preCheckPassed: false,
        errorMsg: '合规预检未通过，请修正后重新提交复核',
      },
    });
    logger.warn('[Pipeline] Review pre-check FAILED for group:', groupId);
    return { passed: false, score: preCheckResult.score, issues: preCheckResult.issues };
  }

  // 预检通过 → 标记已检
  await prisma.batchGroup.update({
    where: { id: groupId },
    data: {
      status: 'checked',
      preCheckResult: JSON.stringify(preCheckResult),
      preCheckPassed: true,
      errorMsg: null,
    },
  });

  logger.info('[Pipeline] Review approved, pre-check passed for group:', groupId);

  // 闭环改造:不再调用单一窗口 API 自动提交。
  // 复核+预检通过后停在 'checked'(待导出申报),由报关员导出标准报关单 XML,
  // 拿到自己公司对接海关的客户端去申报,再把回执回填进系统。
  return { passed: true, score: preCheckResult.score, issues: preCheckResult.issues };
}

/**
 * 复核驳回 → 回到填制步骤
 */
export async function rejectReview(groupId: string, reason: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) throw new Error('分组不存在');
  if (group.status !== 'pending_review' && group.status !== 'pre_check_failed') {
    throw new Error('当前状态不可驳回');
  }

  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'auto_filling', errorMsg: '复核驳回: ' + reason },
  });

  logger.info('[Pipeline] Review rejected for group:', groupId, 'reason:', reason);

  // 重新触发自动填制
  schedule('autofill', groupId);
}

// ============================================================
// 申报提交（复核通过后的自动链路）
// ============================================================

// ============================================================
// 导出报文 = 线下申报登记(替代单一窗口 API 提交)
// ============================================================

/**
 * 报关员导出标准报关单 XML 后调用:
 * checked(预检通过·待导出) → declared(已导出报文·已线下申报·待回执)
 * 同时把关联报关单标记为已提交,记录报文文件名,便于稽查留痕。
 * 已导出过的分组可重复导出,不重复改状态。
 */
export async function markExported(groupId: string, xmlPath?: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) return;
  if (group.status !== 'checked') return; // 仅在「待导出申报」时推进状态,重复导出不影响

  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'declared', declaredAt: new Date(), xmlPath: xmlPath || null, errorMsg: null },
  });

  if (group.declarationId) {
    const { submitDeclaration } = await import('./declarationService');
    submitDeclaration(group.tenantId, group.declarationId).catch((err: any) => {
      logger.error('[Pipeline] Mark declaration submitted failed:', err.message);
    });
  }

  logger.info('[Pipeline] XML exported & declared(offline) for group:', groupId);
}

// ============================================================
// 海关回执处理
// ============================================================

/**
 * 海关接受申报
 */
export async function markCustomsAccepted(groupId: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) throw new Error('分组不存在');
  if (group.status !== 'customs_review' && group.status !== 'declared') {
    throw new Error('当前状态不可标记海关接受');
  }

  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'customs_review', errorMsg: null },
  });

  logger.info('[Pipeline] Customs accepted for group:', groupId);
}

/**
 * 海关退单
 */
export async function markCustomsRejected(groupId: string, code: string, reason: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) throw new Error('分组不存在');

  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'rejected', errorMsg: `海关退单 [${code}]: ${reason}` },
  });

  // 记录到 declaration 表
  if (group.declarationId) {
    const { rejectDeclaration } = await import('./declarationService');
    rejectDeclaration(group.tenantId, group.declarationId, code, reason).catch((err: any) => {
      logger.error('[Pipeline] Failed to mark declaration as rejected:', err.message);
    });
  }

  logger.info('[Pipeline] Customs rejected for group:', groupId, 'code:', code);
}

/**
 * 海关放行
 */
export async function markReleased(groupId: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) throw new Error('分组不存在');
  if (group.status !== 'customs_review' && group.status !== 'declared') throw new Error('当前状态不可放行');

  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'released', errorMsg: null },
  });

  // 报关完成
  if (group.declarationId) {
    const { completeDeclaration } = await import('./declarationService');
    completeDeclaration(group.tenantId, group.declarationId).catch((err: any) => {
      logger.error('[Pipeline] Failed to complete declaration:', err.message);
    });
  }

  logger.info('[Pipeline] Released for group:', groupId);
}

/**
 * 结关确认
 */
export async function markCompleted(groupId: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) throw new Error('分组不存在');
  if (group.status !== 'released') throw new Error('当前状态不可结关');

  await prisma.batchGroup.update({
    where: { id: groupId },
    data: { status: 'completed', errorMsg: null, archivedAt: new Date() },
  });

  logger.info('[Pipeline] Completed for group:', groupId);

  // 结关即自动归档:报关单 + 随附单证 + 回执 + 报文 打包留痕,供一键调档
  archiveGroup(groupId).catch((err: any) => logger.error('[Pipeline] Auto-archive failed:', err.message));
}

/**
 * 自动归档:汇总报关单、随附单证清单、回执/状态、XML报文与操作记录,
 * 写入审计日志形成可追溯归档包(供"一键调档"检索)。结关后自动触发。
 */
export async function archiveGroup(groupId: string): Promise<void> {
  const group = await prisma.batchGroup.findUnique({ where: { id: groupId } });
  if (!group) return;

  const docs = await prisma.document.findMany({
    where: { tenantId: group.tenantId, billOfLading: group.billOfLading },
    select: { fileName: true, category: true },
  });

  await prisma.auditLog.create({
    data: {
      tenantId: group.tenantId,
      action: 'batch_group_archived',
      entityType: 'bill_of_lading',
      entityId: group.billOfLading,
      detail: '自动归档: ' + group.billOfLading
        + ' | 报关单:' + (group.declarationId || '-')
        + ' | 单证' + docs.length + '份(' + docs.map((d: any) => d.fileName).join(',').slice(0, 200) + ')'
        + ' | 报文:' + (group.xmlPath || '-')
        + ' | 申报时间:' + (group.declaredAt ? group.declaredAt.toISOString() : '-'),
    },
  }).catch(() => {});

  logger.info('[Pipeline] Archived group:', groupId, 'docs:', docs.length);
}


// ============================================================
// 卡死恢复 (Stuck-state recovery)
// 在途任务跑在 process.nextTick 里,进程重启/崩溃会让它们丢失,
// 分组就永久停在中间态(ocr_running/ai_checking/auto_filling/pre_checking)。
// 本函数把"超时仍未推进"的分组回退到上一个稳定检查点并重新触发对应步骤;
// 用 errorMsg 里的 [recover:N] 标记累计重试次数,超过上限则置 error,
// 避免"毒单证"(每次都崩的文档)导致无限崩溃循环。
// 由 cron 周期性调用 + 服务启动后调用一次。
// ============================================================

const STUCK_TIMEOUT_MIN = 15;     // 超过该时长(分钟)未推进视为卡死
const MAX_RECOVER_ATTEMPTS = 3;   // 同一分组最多自动恢复次数,超过转人工

// 中间态 -> { 回退到的稳定状态, 是否自动重新触发 }
const STUCK_TRANSITIONS: Record<string, { resetTo: GroupStatus; retrigger?: (groupId: string) => Promise<void> }> = {
  ocr_running:  { resetTo: 'pending',        retrigger: triggerGroupOCR },        // 重跑OCR幂等:仅处理 ocrResult=null 的文档
  ai_checking:  { resetTo: 'ocr_done',       retrigger: triggerGroupAIChecks },   // 重跑前清残留 running 校验
  auto_filling: { resetTo: 'ai_done',        retrigger: startAutoFill },          // startAutoFill 自带 ai_done 守卫
  pre_checking: { resetTo: 'pending_review' },                                    // 不自动重试,由报关员重新点复核(预检是请求态)
};

function getRecoverAttempts(errorMsg?: string | null): number {
  const m = (errorMsg || '').match(/\[recover:(\d+)\]/);
  return m ? parseInt(m[1], 10) : 0;
}

/**
 * 扫描并恢复卡死分组。返回成功重新触发的分组数。
 * @param timeoutMinutes 判定卡死的超时阈值(分钟),默认 15
 */
export async function recoverStuckGroups(timeoutMinutes = STUCK_TIMEOUT_MIN): Promise<number> {
  const cutoff = new Date(Date.now() - timeoutMinutes * 60_000);
  const states = Object.keys(STUCK_TRANSITIONS);

  const stuck = await prisma.batchGroup.findMany({
    where: { status: { in: states }, updatedAt: { lt: cutoff } },
  });
  if (stuck.length === 0) return 0;

  let recovered = 0;
  for (const g of stuck) {
    const plan = STUCK_TRANSITIONS[g.status];
    if (!plan) continue;

    const attempts = getRecoverAttempts(g.errorMsg);
    if (attempts >= MAX_RECOVER_ATTEMPTS) {
      await prisma.batchGroup.update({
        where: { id: g.id },
        data: { status: 'error', errorMsg: `自动恢复${MAX_RECOVER_ATTEMPTS}次仍卡在「${g.status}」,已转人工处理` },
      }).catch(() => {});
      logger.error('[Recovery] 放弃自动恢复, 转人工: group=%s stuck=%s', g.id, g.status);
      continue;
    }

    // ai_checking 重跑前清理残留的 running 校验, 防止重复触发产生脏的校验记录
    if (g.status === 'ai_checking') {
      await prisma.groupValidation.deleteMany({ where: { groupId: g.id, status: 'running' } }).catch(() => {});
    }

    await prisma.batchGroup.update({
      where: { id: g.id },
      data: { status: plan.resetTo, errorMsg: `[recover:${attempts + 1}] 从卡死状态「${g.status}」自动恢复(第${attempts + 1}次)` },
    });
    logger.warn('[Recovery] group=%s 重置 %s -> %s (第%d次)', g.id, g.status, plan.resetTo, attempts + 1);
    recovered++;

    if (plan.retrigger) {
      // 状态已先落库为稳定态; 重新触发函数会再读取并推进, 失败只记录不阻塞其余分组
      plan.retrigger(g.id).catch((err: any) =>
        logger.error('[Recovery] 重新触发失败 group=%s: %s', g.id, err.message));
    }
  }

  logger.info('[Recovery] 本轮恢复 %d/%d 个卡死分组', recovered, stuck.length);
  return recovered;
}

/**
* declarationBuilder.ts —— 报关单构建 / 合规预检 / 海关报文(XML)生成
*
* XML 报文字段命名遵循《海关总署2018年第67号公告·进出口货物报关单申报电子报文格式》
* 结构: <DecMessage><DecHead>...</DecHead><DecLists><DecList/>...</DecLists></DecMessage>
* 该结构与单一窗口/QP 导入模板对齐(详见 sample_declaration.xml)。
*/
import prisma from '../config/database';
import { completion } from './ai/deepseek';
import { logger } from '../config/logger';
import {
TRANSPORT_MODE_CODES, CURRENCY_CODES, COUNTRY_CODES, UNIT_CODES,
SUPERVISION_MODE_CODES, WRAP_TYPE_CODES, DISTRICT_CODES, TRADE_MODE_CODES,
DELIVERY_TERM_CODES, toCustomsCode, resolvesToCode, isStrictCodeMode,
} from './customsCodes';
export interface DeclarationItem {
hsCode?: string; description?: string; quantity?: number; unit?: string;
unitPrice?: number; totalPrice?: number; originCountry?: string; model?: string;
legalQty?: number; legalUnit?: string; legalQty2?: number; legalUnit2?: string;
lineNo?: number; itemNo?: number; tradeMark?: string; currency?: string;
destinationCountry?: string; dutyMode?: string;
tariffRate?: number | null; ftaName?: string | null; ftaRate?: number | null;
dutyPreference?: string; preferentialTrade?: string; originCertType?: string;
}
export interface DeclarationData {
declarationNo?: string; items?: DeclarationItem[]; billOfLading?: string;
tradeTerms?: string; totalValue?: number; grossWeight?: number; netWeight?: number;
destinationPort?: string; destinationCountry?: string; tradeCountry?: string;
supervisionCode?: string; customsMode?: string; taxPreference?: string; customhouseCode?: string;
portOfEntry?: string; portOfLoading?: string; portOfDischarge?: string;
packageType?: string; packageCount?: number | string; currency?: string;
contractNo?: string; vesselFlight?: string; transportMode?: string;
declarant?: string; importerExporter?: string; agentName?: string; agentCode?: string;
consignor?: string; consignee?: string; ieFlag?: string;
documents?: string[]; hsCodes?: string[]; itemDetails?: DeclarationItem[];
[key: string]: any;
}
export interface CustomsMode { code: string; name: string; description?: string; }
export interface DeliveryMethod { code: string; name: string; }
export interface PreCheckIssue {
severity: 'error' | 'warning' | 'info'; code: string; category?: string;
field?: string; message: string; suggestion?: string;
}
export interface PreCheckResult {
passed: boolean; score: number; issues: PreCheckIssue[];
checkedRules?: number; warnings?: string[]; recommendation?: string;
}
export const ECOMMERCE_PLATFORM_CODES: Record<string, string> = {
'Amazon': 'AMZ', '速卖通': 'AE', 'eBay': 'EBY', 'Wish': 'WSH', 'Shopee': 'SP',
'Lazada': 'LZD', 'Temu': 'TM', 'TikTok Shop': 'TTS', 'Shein': 'SHN', '独立站/其他': 'OTHER',
};
export interface CustomsModeInfo {
label: string; supervisionCode: string; taxMethod?: string; description?: string;
requiredFields?: string[]; logisticsRequired?: boolean; allowedTransportModes?: string[];
}
export const CUSTOMS_MODE_INFO: Record<string, CustomsModeInfo> = {
normal: { label: '一般贸易', supervisionCode: '0110', taxMethod: '一般征税', description: '普通一般贸易进出口申报', logisticsRequired: true, allowedTransportModes: ['海运', '空运', '陆运', '铁路'] },
'9610': { label: '跨境电商零售出口', supervisionCode: '9610', taxMethod: '汇总征税', description: '小包裹直邮,三单对碰', logisticsRequired: true, allowedTransportModes: ['空运', '海运', '陆运'] },
'9710': { label: '跨境电商B2B直接出口', supervisionCode: '9710', taxMethod: '一般征税', description: '企业对企业直接出口', logisticsRequired: true, allowedTransportModes: ['海运', '空运', '陆运', '铁路'] },
'9810': { label: '出口海外仓', supervisionCode: '9810', taxMethod: '一般征税', description: '先入仓再销售', logisticsRequired: true, allowedTransportModes: ['海运', '空运', '陆运', '铁路'] },
'1210': { label: '保税电商出口', supervisionCode: '1210', taxMethod: '一般征税', description: '跨境电商综试区保税出口', logisticsRequired: true, allowedTransportModes: ['海运', '空运', '铁路', '陆运'] },
'1239': { label: '保税电商出口A', supervisionCode: '1239', taxMethod: '一般征税', description: '非试点城市保税电商出口', logisticsRequired: true, allowedTransportModes: ['海运', '空运', '铁路', '陆运'] },
'1039': { label: '市场采购贸易', supervisionCode: '1039', taxMethod: '免征不退', description: '专业市场多品种拼箱出口', logisticsRequired: true, allowedTransportModes: ['海运', '空运', '陆运', '铁路'] },
};
const num = (v: unknown): number => {
const n = typeof v === 'number' ? v : parseFloat(String(v ?? ''));
return Number.isFinite(n) ? n : 0;
};
// ============================================================
// 合规预检规则库(退单常见原因)
// ============================================================
type Rule = { code: string; category: string; check: (d: DeclarationData) => PreCheckIssue | null };
const COMPLIANCE_RULES: Rule[] = [
{ code: 'HS001', category: 'classification', check: (d) => {
const items = d.items || [];
const idx = items.findIndex((i) => !i.description || i.description.length < 2);
const miss = items.filter((i) => !i.description || i.description.length < 2);
return miss.length ? { severity: 'error', code: 'HS001', category: 'classification', field: `items.${idx}.description`, message: `${miss.length}项商品描述不完整`, suggestion: '商品描述应包含品名、材质、用途等关键信息' } : null;
} },
{ code: 'HS002', category: 'classification', check: (d) => {
const items = d.items || [];
const bad = items.filter((i) => !/^\d{4}(\.\d{2,4})?$|^\d{8,10}$/.test(String(i.hsCode || '')));
const idx = items.findIndex((i) => !/^\d{4}(\.\d{2,4})?$|^\d{8,10}$/.test(String(i.hsCode || '')));
return bad.length ? { severity: 'error', code: 'HS002', category: 'classification', field: `items.${idx}.hsCode`, message: `${bad.length}项HS编码格式无效`, suggestion: 'HS编码应为 8471.30 或 10 位完整编码,请用AI归类确认' } : null;
} },
{ code: 'VAL001', category: 'valuation', check: (d) => {
const items = d.items || [];
const low = items.filter((i) => num(i.unitPrice) > 0 && num(i.unitPrice) < 0.01);
const idx = items.findIndex((i) => num(i.unitPrice) > 0 && num(i.unitPrice) < 0.01);
return low.length ? { severity: 'warning', code: 'VAL001', category: 'valuation', field: `items.${idx}.unitPrice`, message: `${low.length}项单价异常偏低`, suggestion: '价格过低可能触发海关审价,请核实申报价格真实性' } : null;
} },
{ code: 'VAL002', category: 'valuation', check: (d) => {
const items = d.items || [];
const calc = items.reduce((s, i) => s + num(i.totalPrice), 0);
const total = num(d.totalValue);
return Math.abs(calc - total) / Math.max(calc, 1) > 0.05 ? { severity: 'error', code: 'VAL002', category: 'valuation', field: 'totalValue', message: `申报总金额(${total.toFixed(2)})与明细合计(${calc.toFixed(2)})不一致`, suggestion: '总金额应等于各项金额之和' } : null;
} },
{ code: 'ORI001', category: 'origin', check: (d) => {
const items = d.items || [];
const miss = items.filter((i) => !i.originCountry || String(i.originCountry).length < 2);
const idx = items.findIndex((i) => !i.originCountry || String(i.originCountry).length < 2);
return miss.length ? { severity: 'error', code: 'ORI001', category: 'origin', field: `items.${idx}.originCountry`, message: `${miss.length}项缺少原产国`, suggestion: '每项商品须注明原产国(如 中国/CN、日本/JP)' } : null;
} },
{ code: 'ORI002', category: 'origin', check: (d) => {
const items = d.items || [];
const hasFta = items.some((i) => i.ftaRate != null);
const missDocs = !(d.documents || []).some((x) => /原产地|origin|certificate|coo|form/i.test(x));
return hasFta && missDocs ? { severity: 'warning', code: 'ORI002', category: 'origin', field: 'documents', message: '申报适用FTA优惠税率但未随附原产地证书', suggestion: '享受协定税率须提供有效原产地证书正本,否则按MFN税率申报' } : null;
} },
{ code: 'DOC001', category: 'document', check: (d) => {
const docs = d.documents;
return Array.isArray(docs) && docs.length > 0 && docs.length < 2 ? { severity: 'warning', code: 'DOC001', category: 'document', field: 'documents', message: '随附单证不完整', suggestion: '基本要求:商业发票、装箱单、提单/运单' } : null;
} },
{ code: 'TRA001', category: 'transport', check: (d) => (!d.portOfEntry || String(d.portOfEntry).length < 2) ? { severity: 'error', code: 'TRA001', category: 'transport', field: 'portOfEntry', message: '缺少进出境口岸', suggestion: '请填写口岸(如:上海外高桥、宁波北仑、青岛前湾)' } : null },
{ code: 'TRA002', category: 'transport', check: (d) => !d.transportMode ? { severity: 'error', code: 'TRA002', category: 'transport', field: 'transportMode', message: '缺少运输方式', suggestion: '请选择:海运/空运/陆运/铁路' } : null },
{ code: 'CUR001', category: 'currency', check: (d) => {
const cur = new Set((d.items || []).map((i) => i.currency).filter(Boolean));
return cur.size > 1 ? { severity: 'warning', code: 'CUR001', category: 'currency', field: 'items.currency', message: `同一报关单含${cur.size}种币种: ${[...cur].join(', ')}`, suggestion: '建议统一结算币种' } : null;
} },
{ code: 'COD001', category: 'code', check: (d) => {
if (!isStrictCodeMode()) return null;
if (d.currency && !resolvesToCode(CURRENCY_CODES, d.currency)) return { severity: 'error', code: 'COD001', category: 'code', field: 'currency', message: `币制「${d.currency}」无法解析为海关代码`, suggestion: '请使用标准币制(USD/CNY/EUR…)或在代码表中补录' };
return null;
} },
];
export function runPreCheck(data: DeclarationData, items?: DeclarationItem[]): PreCheckResult {
const d: DeclarationData = { ...data, items: data.items || items || [] };
const issues: PreCheckIssue[] = [];
for (const rule of COMPLIANCE_RULES) {
try { const i = rule.check(d); if (i) issues.push(i); } catch { /* 单条规则异常不影响整体 */ }
}
const errors = issues.filter((i) => i.severity === 'error').length;
const warnings = issues.filter((i) => i.severity === 'warning').length;
const infos = issues.filter((i) => i.severity === 'info').length;
const score = Math.max(0, 100 - errors * 20 - warnings * 5 - infos * 2);
const passed = errors === 0 && score >= 60;
const recommendation = passed
? (score >= 90 ? '合规预检通过,可导出XML申报' : `基本合规,${warnings}条警告建议申报前修正`)
: `合规预检未通过,${errors}条错误必须修正`;
return { passed, score, issues, checkedRules: COMPLIANCE_RULES.length, warnings: [], recommendation };
}
export async function aiPreCheckSupplement(data: DeclarationData, _aiResult?: any): Promise<string | null> {
try {
const items = (data.items || []).map((i) => `HS${i.hsCode} ${i.description} ${num(i.quantity)}${i.unit} @${num(i.unitPrice)}${i.currency} 原产国:${i.originCountry}`).join('\n');
const prompt = `你是资深海关合规专家,请对以下报关单做快速风险评估(200字内,简洁中文):\n运输方式:${data.transportMode}\n口岸:${data.portOfEntry}\n贸易条款:${data.tradeTerms}\n申报总额:${num(data.totalValue)} ${data.currency}\n明细:\n${items}\n请覆盖:1)HS归类合理性 2)价格异常 3)条款与运输匹配 4)其他合规风险 5)总体建议。`;
const text = await completion(prompt, { temperature: 0.3, maxTokens: 500 });
return text && text.trim() ? text.trim() : null;
} catch { return null; }
}
// ============================================================
// 海关报文 XML(2018版67号公告 DecMessage 格式)
// ============================================================
function esc(v: unknown): string {
return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&apos;');
}
export function generateCustomsXML(data: DeclarationData, _options?: any): string {
const items = data.items || [];
const ieFlag = (data.ieFlag || 'E').toUpperCase(); // E 出口 / I 进口
const tradeMode = data.supervisionCode
|| (data.customsMode ? (CUSTOMS_MODE_INFO[data.customsMode]?.supervisionCode || toCustomsCode(TRADE_MODE_CODES, data.customsMode)) : '')
|| '';
const head =
` <DecHead>
<SeqNo></SeqNo>
<PreEntryId></PreEntryId>
<EntryId></EntryId>
<IEFlag>${esc(ieFlag)}</IEFlag>
<CustomMaster>${esc(toCustomsCode(DISTRICT_CODES, data.customhouseCode || ''))}</CustomMaster>
<IEPort>${esc(data.portOfEntry || data.portOfDischarge || '')}</IEPort>
<ContrNo>${esc(data.contractNo || data.declarationNo || '')}</ContrNo>
<TradeName>${esc(data.importerExporter || data.consignor || '')}</TradeName>
<AgentName>${esc(data.declarant || data.agentName || '')}</AgentName>
<AgentCode>${esc(data.agentCode || '')}</AgentCode>
<TrafMode>${esc(toCustomsCode(TRANSPORT_MODE_CODES, data.transportMode || ''))}</TrafMode>
<TrafName>${esc(data.vesselFlight || '')}</TrafName>
<BillNo>${esc(data.billOfLading || data.vesselFlight || '')}</BillNo>
<TradeMode>${esc(tradeMode)}</TradeMode>
<TradeCountry>${esc(toCustomsCode(COUNTRY_CODES, data.tradeCountry || ''))}</TradeCountry>
<DistinatePort>${esc(data.destinationPort || data.portOfDischarge || '')}</DistinatePort>
<TransMode>${esc(toCustomsCode(DELIVERY_TERM_CODES, data.tradeTerms || ''))}</TransMode>
<PackNo>${esc(data.packageCount ?? '')}</PackNo>
<WrapType>${esc(toCustomsCode(WRAP_TYPE_CODES, data.packageType || ''))}</WrapType>
<GrossWet>${num(data.grossWeight).toFixed(5)}</GrossWet>
<NetWt>${num(data.netWeight).toFixed(5)}</NetWt>
<IEDate></IEDate>
</DecHead>`;
const lists = items.map((it, i) =>
` <DecList>
<GNo>${(it.lineNo ?? it.itemNo ?? i + 1)}</GNo>
<CodeTS>${esc(String(it.hsCode || '').replace(/\D/g, ''))}</CodeTS>
<GName>${esc(it.description || '')}</GName>
<GModel>${esc(it.model || '')}</GModel>
<GQty>${num(it.quantity).toFixed(5)}</GQty>
<GUnit>${esc(toCustomsCode(UNIT_CODES, it.unit || ''))}</GUnit>
<DeclPrice>${num(it.unitPrice).toFixed(4)}</DeclPrice>
<DeclTotal>${num(it.totalPrice).toFixed(2)}</DeclTotal>
<TradeCurr>${esc(toCustomsCode(CURRENCY_CODES, it.currency || data.currency || ''))}</TradeCurr>
<OriginCountry>${esc(toCustomsCode(COUNTRY_CODES, it.originCountry || ''))}</OriginCountry>
<DestinationCountry>${esc(toCustomsCode(COUNTRY_CODES, it.destinationCountry || data.destinationCountry || data.tradeCountry || ''))}</DestinationCountry>
<DutyMode>${esc(it.dutyMode || '1')}</DutyMode>
</DecList>`).join('\n');
return `<?xml version="1.0" encoding="UTF-8"?>
<!-- 字段命名依据: 海关总署2018年第67号公告《进出口货物报关单申报电子报文格式》 -->
<DecMessage>
${head}
<DecLists>
${lists}
</DecLists>
</DecMessage>`;
}
export function getXmlGenerator(_mode: string): ((data: any) => string) | null {
return generateCustomsXML;
}
// ============================================================
// 从平台数据富化构建报关单(按HS查描述/单位/MFN税率 + 最优FTA)
// ============================================================
export async function buildDeclaration(tenantId: string, input: DeclarationData): Promise<any> {
const hsCodes = input.hsCodes || (input.itemDetails || []).map((d) => d.hsCode!).filter(Boolean);
const detailsMap = new Map((input.itemDetails || []).map((d) => [d.hsCode, d]));
const items: DeclarationItem[] = [];
for (let i = 0; i < hsCodes.length; i++) {
const code = hsCodes[i]!;
const detail = detailsMap.get(code);
const hsRecord = await prisma.hSCode.findUnique({ where: { code } }).catch(() => null);
const prefix4 = code.replace(/\D/g, '').slice(0, 4);
const originRules = await prisma.originRule.findMany({
where: { hsCode: { startsWith: prefix4 } },
include: { ftaAgreement: { select: { shortName: true } } },
take: 10,
}).catch(() => [] as any[]);
const bestFta = originRules
.filter((r: any) => r.tariffReduction != null)
.sort((a: any, b: any) => (a.tariffReduction) - (b.tariffReduction))[0];
const quantity = num(detail?.quantity ?? 1) || 1;
const unitPrice = num(detail?.unitPrice);
items.push({
itemNo: i + 1, lineNo: i + 1, hsCode: code,
description: detail?.description || hsRecord?.description || `商品 ${code}`,
quantity, unit: hsRecord?.unit || detail?.unit || '件',
unitPrice, totalPrice: unitPrice * quantity,
currency: input.currency || 'USD',
originCountry: detail?.originCountry || '中国',
tariffRate: hsRecord?.tariffRate ?? null,
ftaRate: bestFta?.tariffReduction ?? null,
ftaName: bestFta?.ftaAgreement?.shortName ?? null,
});
}
const docs = await prisma.document.findMany({ where: { tenantId }, orderBy: { createdAt: 'desc' }, take: 10 }).catch(() => [] as any[]);
const today = new Date();
const dateStr = today.getFullYear().toString().slice(2) + String(today.getMonth() + 1).padStart(2, '0') + String(today.getDate()).padStart(2, '0');
const seq = String(Math.floor(Math.random() * 99999)).padStart(5, '0');
const customsMode = input.customsMode || 'normal';
const supervisionCode = input.supervisionCode || CUSTOMS_MODE_INFO[customsMode]?.supervisionCode || '0110';
const declaration: DeclarationData = {
declarationNo: `CUS${dateStr}${seq}`,
declarant: input.declarant || '平台用户',
importerExporter: input.importerExporter || '',
transportMode: input.transportMode || '海运',
vesselFlight: input.vesselFlight || '',
portOfLoading: input.portOfLoading || '',
portOfDischarge: input.portOfDischarge || '',
portOfEntry: input.portOfEntry || '',
tradeTerms: input.tradeTerms || 'FOB',
currency: input.currency || 'USD',
customsMode, supervisionCode,
items,
documents: docs.map((d: any) => d.fileName),
totalValue: items.reduce((s, i) => s + num(i.totalPrice), 0),
};
const preCheck = runPreCheck(declaration);
const aiInsight = await aiPreCheckSupplement(declaration).catch(() => null);
if (aiInsight) preCheck.issues.push({ severity: 'info', code: 'AI001', category: 'ai_analysis', message: aiInsight, suggestion: 'AI分析仅供参考' });
const xmlContent = generateCustomsXML(declaration);
await prisma.auditLog.create({
data: { tenantId, action: 'declaration_build', detail: `报关单构建: ${items.length}项 | 预检得分 ${preCheck.score} | ${preCheck.passed ? '通过' : '未通过'}` },
}).catch(() => {});
import('./webhook/eventEmitter').then(({ eventEmitter }) =>
eventEmitter.fire('declaration.build', tenantId, {
items: items.map((i) => ({ hsCode: i.hsCode, description: String(i.description).slice(0, 100), quantity: i.quantity, totalPrice: i.totalPrice })),
totalValue: declaration.totalValue, score: preCheck.score, passed: preCheck.passed,
}).catch(() => {}),
).catch(() => {});
logger.info('[declarationBuilder] built %d items for tenant %s score=%d', items.length, tenantId, preCheck.score);
return { declaration, preCheck, xmlContent, exportedAt: new Date().toISOString() };
}
export async function batchBuildDeclarations(tenantId: string, batches: DeclarationData[]): Promise<any[]> {
const results: any[] = [];
for (const batch of batches) results.push(await buildDeclaration(tenantId, batch));
return results;
}

import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { Card, Row, Col, Statistic, Typography, Spin, Table, Tag, Empty, Progress, List, Tooltip } from 'antd';
import {
  FileTextOutlined, FileSearchOutlined,
  ClockCircleOutlined, CheckCircleOutlined, CloseCircleOutlined,
  RiseOutlined, ThunderboltOutlined, HistoryOutlined,
  ScanOutlined, SearchOutlined, ExportOutlined, ArrowRightOutlined,
  ApiOutlined, RobotOutlined, FileProtectOutlined, DashboardOutlined,
  SafetyCertificateOutlined, InboxOutlined, SwapOutlined, FolderOpenOutlined,
  SafetyOutlined, FilePdfOutlined, DollarOutlined, SoundOutlined,
  BarChartOutlined, KeyOutlined, TeamOutlined, SettingOutlined, QuestionCircleOutlined,
} from '@ant-design/icons';

const { Title, Text, Paragraph } = Typography;

// ===== 迷你趋势线 =====
function MiniSparkline({ data, color, height }: { data: number[]; color?: string; height?: number }) {
  color = color || '#1890ff';
  height = height || 40;
  if (!data || data.length === 0) {
    return <div style={{ height, color: '#ccc', fontSize: 12, display: 'flex', alignItems: 'center' }}>暂无数据</div>;
  }
  const max = Math.max(...data, 1);
  const w = 100 / data.length;
  return (
    <div style={{ height, display: 'flex', alignItems: 'flex-end', gap: 2, padding: '4px 0' }}>
      {data.map((v: number, i: number) => (
        <div key={i} style={{
          width: w + '%', height: (v / max) * 100 + '%',
          background: color, borderRadius: '2px 2px 0 0',
          opacity: 0.6 + (i / data.length) * 0.4,
          minHeight: v > 0 ? 4 : 0,
        }} title={'' + v} />
      ))}
    </div>
  );
}

// ===== 资源用量进度条 =====
function UsageBar({ label, used, limit, icon, color }: { label: string; used: number; limit: number; icon: React.ReactNode; color: string }) {
  const pct = limit > 0 ? Math.min(Math.round((used / limit) * 100), 100) : 0;
  const status = pct >= 90 ? 'exception' : pct >= 70 ? 'active' : 'normal';
  return (
    <div style={{ marginBottom: 12 }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 13, marginBottom: 2 }}>
        <span>{icon} {label}</span>
        <span>{used}/{limit}</span>
      </div>
      <Progress percent={pct} size="small" status={status} strokeColor={color} showInfo={false} />
    </div>
  );
}

// ===== 快捷入口配置 —— 与左侧菜单一一对应 =====
// 每一项的 key 都对应 /dashboard/<key> 路由,点击即跳转到对应页面。
interface NavEntry { key: string; label: string; icon: React.ReactNode; color: string; desc?: string }

const navGroups: { title: string; items: NavEntry[] }[] = [
  {
    title: '报关作业',
    items: [
      { key: 'risk-dashboard', label: '风控看板', icon: <SafetyCertificateOutlined />, color: '#cf1322', desc: '风险预警一览' },
      { key: 'bill-of-lading', label: '提单管理', icon: <InboxOutlined />, color: '#1890ff', desc: '提单录入维护' },
      { key: 'bl-check', label: '提单核对', icon: <CheckCircleOutlined />, color: '#52c41a', desc: '提单一致性校验' },
      { key: 'declaration-compare', label: '报关核对', icon: <SwapOutlined />, color: '#13c2c2', desc: '单证比对差异' },
      { key: 'tariff-workbench', label: '关务工具箱', icon: <SearchOutlined />, color: '#722ed1', desc: 'HS编码 / 关税测算' },
      { key: 'archive-search', label: '归档调档', icon: <FolderOpenOutlined />, color: '#fa8c16', desc: '历史单证检索' },
      { key: 'audit-logs', label: '操作日志', icon: <SafetyOutlined />, color: '#8c8c8c', desc: '全程操作留痕' },
      { key: 'supplier-invoice', label: '供应商发票', icon: <FilePdfOutlined />, color: '#eb2f96', desc: '发票识别归集' },
    ],
  },
  {
    title: '税费退税',
    items: [
      { key: 'tax-rebate-manage', label: '退税管理', icon: <DollarOutlined />, color: '#52c41a', desc: '出口退税跟踪' },
    ],
  },
  {
    title: '合规情报',
    items: [
      { key: 'policy', label: '法规变化', icon: <SoundOutlined />, color: '#fa541c', desc: '政策法规动态' },
      { key: 'license-ledger', label: '证件台账', icon: <SafetyCertificateOutlined />, color: '#1890ff', desc: '资质证件管理' },
      { key: 'ai', label: 'AI助手', icon: <RobotOutlined />, color: '#13c2c2', desc: '智能问答助手' },
    ],
  },
  {
    title: '数据报表',
    items: [
      { key: 'reports', label: '统计报表', icon: <BarChartOutlined />, color: '#722ed1', desc: '经营数据分析' },
    ],
  },
  {
    title: '系统管理',
    items: [
      { key: 'api-keys', label: 'API密钥', icon: <KeyOutlined />, color: '#8c8c8c', desc: '接口凭证' },
      { key: 'webhooks', label: 'Webhook集成', icon: <ApiOutlined />, color: '#8c8c8c', desc: '事件回调' },
      { key: 'usage', label: '用量统计', icon: <BarChartOutlined />, color: '#8c8c8c', desc: '套餐消耗' },
      { key: 'sub-accounts', label: '子账号', icon: <TeamOutlined />, color: '#8c8c8c', desc: '成员与权限' },
      { key: 'payments', label: '账单与支付', icon: <DollarOutlined />, color: '#8c8c8c', desc: '订阅账单' },
      { key: 'settings', label: '设置', icon: <SettingOutlined />, color: '#8c8c8c', desc: '企业资料' },
      { key: 'help', label: '帮助中心', icon: <QuestionCircleOutlined />, color: '#8c8c8c', desc: '使用文档' },
    ],
  },
];

export default function DashboardPage() {
  const navigate = useNavigate();
  const [stats, setStats] = useState<any>(null);
  const [trends, setTrends] = useState<any[]>([]);
  const [activities, setActivities] = useState<any[]>([]);
  const [usage, setUsage] = useState<any>(null);
  const [recentDocs, setRecentDocs] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);

  const go = (key: string) => navigate('/dashboard/' + key);

  useEffect(() => {
    const token = localStorage.getItem('token');
    const headers = { Authorization: 'Bearer ' + token };

    Promise.all([
      fetch('/api/dashboard/stats', { headers }).then(r => r.json()).catch(() => ({})),
      fetch('/api/dashboard/trends', { headers }).then(r => r.json()).catch(() => []),
      fetch('/api/dashboard/activity', { headers }).then(r => r.json()).catch(() => []),
      fetch('/api/usage', { headers }).then(r => r.json()).catch(() => null),
      fetch('/api/documents', { headers })
        .then(r => r.json()).catch(() => []),
    ]).then(([s, t, a, u, docs]) => {
      setStats(s.data || s);
      setTrends(Array.isArray(t) ? t : []);
      setActivities(Array.isArray(a) ? a : []);
      setUsage(u || null);
      const docList = Array.isArray(docs) ? docs : (docs?.data || docs?.items || []);
      setRecentDocs(docList.slice(0, 5));
    }).catch(e => {
      console.error('Dashboard load failed:', e);
    }).finally(() => {
      setLoading(false);
    });
  }, []);

  if (loading) {
    return (
      <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', minHeight: '60vh' }}>
        <Spin size="large" tip="加载中..." />
      </div>
    );
  }

  const trendsData = trends.map(d => d.apiCalls || 0);
  const aiTrends = trends.map(d => d.aiCalls || 0);
  const docTrends = trends.map(d => d.documents || 0);

  const statusMap: Record<string, { color: string; icon: React.ReactNode; text: string }> = {
    DRAFT: { color: 'default', icon: <ClockCircleOutlined />, text: '草稿' },
    SUBMITTED: { color: 'processing', icon: <ClockCircleOutlined />, text: '已申报' },
    ACCEPTED: { color: 'blue', icon: <CheckCircleOutlined />, text: '已受理' },
    PASSED: { color: 'success', icon: <CheckCircleOutlined />, text: '已通过' },
    FAILED: { color: 'error', icon: <CloseCircleOutlined />, text: '退回' },
  };

  const docColumns = [
    { title: '文件名', dataIndex: 'fileName', key: 'fileName', ellipsis: true, render: (n: string) => n || '-' },
    { title: '类别', dataIndex: 'category', key: 'category', width: 110, render: (c: string) => c || '-' },
    { title: '提单号', dataIndex: 'billOfLading', key: 'billOfLading', width: 150, render: (b: string) => b || '-' },
    {
      title: '识别', dataIndex: 'ocrResult', key: 'ocrResult', width: 90,
      render: (o: string) => o ? <Tag color="success">已识别</Tag> : <Tag>未识别</Tag>,
    },
    {
      title: '上传时间', dataIndex: 'createdAt', key: 'createdAt', width: 160,
      render: (t: string) => t ? new Date(t).toLocaleString('zh-CN') : '-',
    },
  ];

  const actionLabels: Record<string, string> = {
    ai_classify: 'AI归类',
    document_upload: '上传单证',
    declaration_build: '构建报关单',
    ocr: 'OCR识别',
    cbam: 'CBAM测算',
    rcep: 'RCEP核算',
  };

  return (
    <div style={{ padding: 24 }}>
      <Title level={4} style={{ marginBottom: 16 }}>
        <DashboardOutlined /> 总览
      </Title>

      {/* ===== 主入口:自动化报关(整条流水线) ===== */}
      <Card
        hoverable
        onClick={() => go('batch-archive')}
        style={{
          marginBottom: 24, cursor: 'pointer', border: 'none',
          background: 'linear-gradient(135deg, #1d39c4 0%, #2f54eb 55%, #722ed1 100%)',
        }}
        bodyStyle={{ padding: 24 }}
      >
        <Row align="middle" gutter={[16, 16]}>
          <Col flex="auto">
            <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 8 }}>
              <ThunderboltOutlined style={{ fontSize: 30, color: '#fff' }} />
              <span style={{ fontSize: 22, fontWeight: 700, color: '#fff' }}>自动化报关</span>
              <Tag color="gold" style={{ marginLeft: 4 }}>主入口</Tag>
            </div>
            <Paragraph style={{ color: 'rgba(255,255,255,0.88)', margin: 0, fontSize: 14 }}>
              上传单证后自动跑完：OCR识别 → AI校验 → 自动填制 → 人工复核 → 合规预检 → 电子申报 → 海关审核 → 放行结关。
              制单 / 模板 / 批量 / 对比工具均已内置。
            </Paragraph>
          </Col>
          <Col>
            <span style={{ color: '#fff', fontSize: 16, fontWeight: 600, whiteSpace: 'nowrap' }}>
              立即开始 <ArrowRightOutlined />
            </span>
          </Col>
        </Row>
      </Card>

      {/* ===== 快捷入口:与左侧菜单分组对应 ===== */}
      {navGroups.map(group => (
        <div key={group.title} style={{ marginBottom: 20 }}>
          <Text type="secondary" style={{ fontSize: 13, fontWeight: 600, letterSpacing: 1 }}>
            {group.title}
          </Text>
          <Row gutter={[12, 12]} style={{ marginTop: 8 }}>
            {group.items.map(item => (
              <Col xs={12} sm={8} md={6} lg={4} key={item.key}>
                <Card
                  hoverable
                  size="small"
                  onClick={() => go(item.key)}
                  style={{ cursor: 'pointer', height: '100%' }}
                  bodyStyle={{ padding: 14 }}
                >
                  <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                    <span style={{
                      fontSize: 20, color: item.color, lineHeight: 1,
                      display: 'inline-flex', width: 36, height: 36, borderRadius: 8,
                      alignItems: 'center', justifyContent: 'center',
                      background: item.color + '14',
                    }}>
                      {item.icon}
                    </span>
                    <div style={{ minWidth: 0 }}>
                      <div style={{ fontWeight: 600, fontSize: 14, lineHeight: 1.3 }}>{item.label}</div>
                      {item.desc && (
                        <div style={{
                          fontSize: 11, color: '#999', whiteSpace: 'nowrap',
                          overflow: 'hidden', textOverflow: 'ellipsis',
                        }}>{item.desc}</div>
                      )}
                    </div>
                  </div>
                </Card>
              </Col>
            ))}
          </Row>
        </div>
      ))}

      {/* ===== 关键指标 ===== */}
      <Row gutter={[16, 16]} style={{ marginTop: 8, marginBottom: 24 }}>
        <Col xs={12} sm={6}>
          <Card size="small" hoverable onClick={() => go('archive-search')} style={{ cursor: 'pointer' }}><Statistic title="总单证数" value={stats?.totalDocuments ?? 0} prefix={<FileTextOutlined />} valueStyle={{ color: '#1890ff' }} /></Card>
        </Col>
        <Col xs={12} sm={6}>
          <Card size="small" hoverable onClick={() => go('tariff-workbench')} style={{ cursor: 'pointer' }}><Statistic title="HS编码数" value={stats?.totalHsQueries ?? 0} prefix={<FileSearchOutlined />} valueStyle={{ color: '#722ed1' }} /></Card>
        </Col>
        <Col xs={12} sm={6}>
          <Card size="small" hoverable onClick={() => go('batch-archive')} style={{ cursor: 'pointer' }}><Statistic title="待申报批次" value={stats?.pendingDeclarations ?? 0} prefix={<ClockCircleOutlined />} valueStyle={{ color: '#fa8c16' }} /></Card>
        </Col>
        <Col xs={12} sm={6}>
          <Card size="small" hoverable onClick={() => go('archive-search')} style={{ cursor: 'pointer' }}><Statistic title="已归档批次" value={stats?.archivedGroups ?? 0} prefix={<FileProtectOutlined />} valueStyle={{ color: '#52c41a' }} /></Card>
        </Col>
      </Row>

      <Row gutter={[16, 16]} style={{ marginBottom: 24 }}>
        <Col xs={24} lg={12}>
          <Card title={<span><RiseOutlined /> 近30天趋势</span>} size="small">
            <Row gutter={16}>
              <Col span={8}>
                <Text type="secondary" style={{ fontSize: 12 }}>API调用</Text>
                <MiniSparkline data={trendsData} color="#cf1322" />
              </Col>
              <Col span={8}>
                <Text type="secondary" style={{ fontSize: 12 }}>AI调用</Text>
                <MiniSparkline data={aiTrends} color="#13c2c2" />
              </Col>
              <Col span={8}>
                <Text type="secondary" style={{ fontSize: 12 }}>单证上传</Text>
                <MiniSparkline data={docTrends} color="#1890ff" />
              </Col>
            </Row>
          </Card>
        </Col>
        <Col xs={24} lg={12}>
          <Card title={<span><ThunderboltOutlined /> 套餐用量</span>} size="small">
            {usage && usage.usage ? (
              <>
                <UsageBar label="AI归类" used={usage.usage.ai_classify?.current ?? 0} limit={usage.usage.ai_classify?.limit ?? 0} icon={<RobotOutlined />} color="#13c2c2" />
                <UsageBar label="单证上传" used={usage.usage.document_upload?.current ?? 0} limit={usage.usage.document_upload?.limit ?? 0} icon={<FileTextOutlined />} color="#1890ff" />
                <UsageBar label="OCR识别" used={usage.usage.ocr?.current ?? 0} limit={usage.usage.ocr?.limit ?? 0} icon={<ScanOutlined />} color="#722ed1" />
                <UsageBar label="报关单构建" used={usage.usage.declaration_build?.current ?? 0} limit={usage.usage.declaration_build?.limit ?? 0} icon={<ExportOutlined />} color="#cf1322" />
              </>
            ) : (
              <Empty description="暂无用量数据" image={Empty.PRESENTED_IMAGE_SIMPLE} />
            )}
          </Card>
        </Col>
      </Row>

      <Row gutter={[16, 16]}>
        <Col xs={24} lg={14}>
          <Card
            title={<span><FileProtectOutlined /> 最近单证</span>}
            size="small"
            extra={<a onClick={() => go('archive-search')}>查看全部</a>}
          >
            {recentDocs.length > 0 ? (
              <Table dataSource={recentDocs} columns={docColumns} rowKey={(r) => r.id || Math.random().toString()} pagination={false} size="small" />
            ) : (
              <Empty description="暂无单证数据，点击上方「自动化报关」开始" image={Empty.PRESENTED_IMAGE_SIMPLE} />
            )}
          </Card>
        </Col>
        <Col xs={24} lg={10}>
          <Card title={<span><HistoryOutlined /> 最近动态</span>} size="small">
            {activities.length > 0 ? (
              <List
                size="small"
                dataSource={activities.slice(0, 8)}
                renderItem={(item: any) => (
                  <List.Item>
                    <List.Item.Meta
                      avatar={
                        <Tooltip title={item.action}>
                          {item.action?.includes('ai') ? <RobotOutlined style={{ color: '#13c2c2' }} /> :
                           item.action?.includes('document') ? <FileTextOutlined style={{ color: '#1890ff' }} /> :
                           item.action?.includes('upload') ? <ScanOutlined style={{ color: '#722ed1' }} /> :
                           <ClockCircleOutlined style={{ color: '#999' }} />}
                        </Tooltip>
                      }
                      title={<span style={{ fontSize: 13 }}>{actionLabels[item.action] || item.action}</span>}
                      description={<span style={{ fontSize: 12, color: '#999' }}>{(item.detail || '').slice(0, 40)}</span>}
                    />
                    <div style={{ fontSize: 11, color: '#bbb', whiteSpace: 'nowrap' }}>
                      {item.createdAt ? new Date(item.createdAt).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : ''}
                    </div>
                  </List.Item>
                )}
              />
            ) : (
              <Empty description="暂无动态" image={Empty.PRESENTED_IMAGE_SIMPLE} />
            )}
          </Card>
        </Col>
      </Row>
    </div>
  );
}

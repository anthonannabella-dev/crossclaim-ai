# ===== 密钥/环境变量（务必忽略，避免泄露 DeepSeek/数据库等凭据）=====
.env
.env.*
!.env.example
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
*.env

# ===== 依赖 =====
node_modules/
**/node_modules/
.pnp
.pnp.js

# ===== 构建产物 =====
dist/
build/
backend/dist/
frontend/dist/
*.tsbuildinfo

# ===== Prisma 本地产物 =====
**/.prisma/

# ===== 日志 =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== 运行时/缓存 =====
.cache/
tmp/
temp/
coverage/

# ===== 上传/对象存储本地落盘（按需）=====
uploads/
storage/

# ===== 编辑器/系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ============================================================
# 安全加固追加 (P0/P3) — 防止打包再次夹带密钥/临时文件
# 注意: zip -r 不读 .gitignore; 分发请用 `git archive` 或下方 cleanup 脚本
# ============================================================

# ----- 散落的 token / 凭据文件 -----
*_token.txt
.*_token.txt
*.test_token.txt
_ap_token.txt

# ----- 一次性临时文件 (SQL/JS/打包产物) -----
_tmp_*
_tmp_bundle.js
*.bak
*.orig

# ----- 一次性调试 / 脚手架脚本 (根目录) -----
/check_*.js
/trigger_*.js
/gen_token*.js
/verify_*.js
/fix_*.js
/fixed_*.js
/reset*.js
/archive_new*.js
/do_upload.js
/rearchive.js
/final_verify.js
/test_api*.js
/test_regex*.js

# ----- 自动备份目录 -----
.hermes_backup*/
backups/
*.backup/

# ----- 重复的 schema / compose 副本 -----
schema2.prisma
*2.prisma
docker-compose.*.bak

# ----- 清理脚本产生的回收站 -----
.trash_*/

{
  "name": "@crossclaim/api",
  "version": "0.1.0",
  "private": true,
  "description": "CrossClaim AI — 资金追回操作系统 · 核心 API",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {

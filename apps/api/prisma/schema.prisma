// ============================================================
// CrossClaim AI · 领域模型（Gate 0 · C-0002 REVISE 后）
// ------------------------------------------------------------
// 模型清单：25 个核心模型 + 1 个联结模型（CaseEvidence）= 26
// 架构基准见 ARCHITECTURE_CONTRACT.md；说明见 DOMAIN_MODEL.md
//
// 租户隔离策略（重要）：
//   1) 每个 tenant-owned 模型显式带 organizationId
//   2) 每个 tenant-owned 模型带 @@unique([organizationId, id])
//   3) 跨表引用一律使用单列 FK（Prisma 限制：可选关系不能配复合外键），
//      "引用对象必须同租户"由**数据库触发器**强制 —— 见 migration 中的
//      crossclaim_assert_tenant_integrity() 与各表 trigger。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 枚举
// ============================================================

enum RecoveryDomain {
  PLATFORM
  LOGISTICS
  CUSTOMS
}

enum Channel {
  AMAZON_FBA
  AMAZON_OTHER
  UPS
  FEDEX
  DHL
  FREIGHT_FORWARDER
  INSURANCE
  CUSTOMS_BROKER
  OTHER
}

enum MembershipRole {
  OWNER
  ADMIN
  OPS
  FINANCE
  VIEWER
}

enum SourceConnectionKind {
  FILE_UPLOAD
  API
  SFTP
  EMAIL
  MANUAL
}

enum SourceConnectionStatus {
  ACTIVE
  PAUSED
  NEEDS_AUTH
  ERROR
  REVOKED
}

enum FileKind {
  PDF
  XLSX
  CSV
  DOCX
  IMAGE
  XML
  OTHER
}

enum ImportStatus {
  PENDING
  PARSING
  IMPORTED
  PARTIAL
  FAILED
}

enum OpportunityStatus {
  DETECTED
  QUALIFIED
  REJECTED
  CONVERTED
  EXPIRED
}

enum CaseStatus {
  OPEN
  COLLECTING_EVIDENCE
  READY_TO_CLAIM
  CLAIMED
  APPEALING
  WON
  PARTIALLY_WON
  LOST
  SETTLED
  CLOSED
}

/// MSG-20260929-23：dueAt 的来源（禁止自由文本；未知时留空并给 ACTION）
enum ClaimDeadlineSource {
  PLATFORM_NOTICE
  USER_INPUT
  CONTRACT
  UNKNOWN
}

/// MSG-20260929-23：终局原因（枚举化，禁自由文本）
enum ClaimTerminalReasonCode {
  PLATFORM_DECISION
  DEADLINE_MISSED
  INSUFFICIENT_EVIDENCE
  WITHDRAWN_BY_SELLER
  DUPLICATE_CLAIM
  OTHER
}
enum ClaimStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  NO_RESPONSE
  WITHDRAWN
}

enum AppealStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  OVERTURNED
  REJECTED
  WITHDRAWN
}

enum EvidenceKind {
  CONTRACT
  RATE_CARD
  INVOICE
  CREDIT_NOTE
  TRACKING
  POD
  EMAIL
  CUSTOMS_DOC
  BROKER_CORRESPONDENCE
  OTHER
}

enum GraphNodeType {
  ORGANIZATION
  CHANNEL
  ACCOUNT
  SHIPMENT
  INVOICE
  OPPORTUNITY
  CASE
  CLAIM
  SETTLEMENT
  OTHER
}

enum GraphEdgeType {
  CAUSES
  RELATED_TO
  DUPLICATES
  DERIVED_FROM
  RESPONSIBLE_FOR
  SAME_SHIPMENT
  OTHER
}

enum EvidenceEdgeType {
  SUPPORTS
  REFUTES
  CONTEXT_FOR
  DUPLICATES
  OTHER
}

/// 含保险公司与海关当局（C 域需要）
enum RouteTarget {
  PLATFORM
  CARRIER
  FREIGHT_FORWARDER
  INSURER
  CUSTOMS_AUTHORITY
  CUSTOMS_BROKER
  CUSTOMER_SELF
  NONE
}

enum RouteStatus {
  PROPOSED
  CONFIRMED
  EXECUTED
  FAILED
  ABANDONED
}

enum RuleScope {
  PLATFORM_FEE
  FREIGHT_RATE
  SLA
  DIM_WEIGHT
  FUEL_SURCHARGE
  ACCESSORIAL
  DUPLICATE_CHARGE
  INSURANCE
  CUSTOMS_DUTY
  OTHER
}

enum RuleTier {
  CUSTOMER_CONTRACT
  CUSTOMER_RATE_CARD
  CARRIER_TARIFF
  DATED_POLICY
  DEFAULT
}

/// 全局规则 vs 租户规则
enum RuleOwnerType {
  SYSTEM
  TENANT
}

enum RuleEvaluationResult {
  PASS
  OPPORTUNITY
  NEEDS_MORE_DATA
  ERROR
}

enum SettlementStatus {
  EXPECTED
  RECEIVED
  PARTIAL
  DISPUTED
  VOID
}

enum SettlementSource {
  PLATFORM_CREDIT
  CARRIER_CREDIT
  INSURER_PAYOUT
  BANK_TRANSFER
  CHECK
  OFFSET
  OTHER
}

enum LedgerEntryType {
  DISCOVERED
  RECOVERED
  ADJUSTMENT
  REVERSAL
  WRITE_OFF
}

enum BillingStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  VOID
  WRITTEN_OFF
}

enum FeeBasis {
  RECOVERED_AMOUNT_PCT
  FIXED
  TIERED
  NONE
}

enum AuditActorType {
  USER
  SYSTEM
  AI
  EXTERNAL
}

// ============================================================
// 一、组织与用户
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  plan      String   @default("TRIAL")
  locale    String   @default("zh-CN")
  timezone  String   @default("Asia/Shanghai")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  sessions          Session[]
  invitations       UserInvitation[]
  connections       SourceConnection[]
  fileAssets        FileAsset[]
  importBatches     ImportBatch[]
  transactions      SourceTransaction[]
  canonicalFacts    CanonicalFact[]
  canonicalFactSources CanonicalFactSource[]
  ruleEvaluationShadows RuleEvaluationShadow[]
  opportunities     RecoveryOpportunity[]
  graphNodes        RecoveryGraphNode[]
  graphEdges        RecoveryGraphEdge[]
  evidence          EvidenceArtifact[]
  evidenceEdges     EvidenceEdge[]
  cases             Case[]
  caseEvidences     CaseEvidence[]
  caseOpportunities CaseOpportunity[]
  routes            RecoveryRoute[]
  claims            Claim[]
  appeals           Appeal[]
  ruleSets          RuleSet[]
  ruleVersions      RuleVersion[]
  ruleEvaluations   RuleEvaluation[]
  settlements       Settlement[]
  ledgerEntries     RecoveryLedgerEntry[]
  billingInvoices   BillingInvoice[]
  feeCalculations   FeeCalculation[]
  auditLogs         AuditLog[]
  payments          Payment[]
  paymentEvents     PaymentEvent[]
  paymentAttempts   PaymentProcessingAttempt[]
  claimItems        ClaimItem[]
  claimItemEvidences ClaimItemEvidence[]
  recoveryPayouts   RecoveryPayout[]
  killSwitchRequests KillSwitchRequest[]
  platformWriteAttempts PlatformWriteAttempt[]
  recoveryPackages      RecoveryPackage[]
  recoveryPackageArtifacts RecoveryPackageArtifact[]
  manualRecoverySubmissions RecoveryManualSubmission[]
  manualRecoverySubmissionReferences RecoveryManualSubmissionReference[]
  manualRecoverySubmissionEvidences RecoveryManualSubmissionEvidence[]
  // R45 S1（MSG-20261001-45 / -46）：Outcome / Reimbursement Reconciliation
  providerOutcomeFacts          ProviderOutcomeFact[]
  reimbursementFacts            ReimbursementFact[]
  expectedRecoveryBases         ExpectedRecoveryBasis[]
  reconciliationOverrides       ReconciliationOverrideDecision[]
  reconciliationProjections     ClaimReconciliationProjection[]
  reconciliationProjectionFacts ClaimReconciliationProjectionFact[]
  reconciliationTolerancePolicies ReconciliationTolerancePolicy[]

  @@index([status])
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  displayName   String
  status        String    @default("ACTIVE")
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  /// C-0008-A：改密后以此时间作废既有会话
  passwordChangedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
  auditLogs   AuditLog[]

  @@index([status])
}

model Membership {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole @default(VIEWER)
  isActive       Boolean        @default(true)
  invitedBy      String?
  joinedAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, role])
}

// ============================================================
// 二、数据进入系统
// ============================================================

model SourceConnection {
  id             String                 @id @default(uuid())
  organizationId String
  domain         RecoveryDomain
  channel        Channel
  kind           SourceConnectionKind
  status         SourceConnectionStatus @default(NEEDS_AUTH)
  label          String
  credentialRef  String?
  config         Json?
  lastSyncAt     DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileAssets   FileAsset[]
  batches      ImportBatch[]
  transactions SourceTransaction[]
  evidence     EvidenceArtifact[]

  @@unique([organizationId, channel, label])
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model FileAsset {
  id             String   @id @default(uuid())
  organizationId String
  connectionId   String?
  kind           FileKind
  storageKey     String
  originalName   String
  mimeType       String?
  sizeBytes      Int?
  sha256         String?
  uploadedBy     String?
  sourceRef      String?
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SourceConnection?  @relation(fields: [connectionId], references: [id])
  batches      ImportBatch[]
  evidence     EvidenceArtifact[]
  recoveryPackageArtifacts RecoveryPackageArtifact[]

  @@unique([organizationId, id])
  @@index([organizationId, sha256])
  @@index([organizationId, createdAt])
}

model ImportBatch {
  id             String         @id @default(uuid())
  organizationId String
  connectionId   String?
  fileAssetId    String?
  domain         RecoveryDomain
  channel        Channel
  status         ImportStatus   @default(PENDING)
  rowsTotal      Int            @default(0)
  rowsOk         Int            @default(0)
  rowsFailed     Int            @default(0)
  columnMapping  Json?
  errorReport    Json?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  createdBy      String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SourceConnection?   @relation(fields: [connectionId], references: [id])
  fileAsset    FileAsset?          @relation(fields: [fileAssetId], references: [id])
  transactions SourceTransaction[]

  @@unique([organizationId, id])
  @@index([organizationId, channel, startedAt])
}

/// 原始业务交易。§七.2/§七.3：与账本严格分离。
/// 溯源链只能走：SourceTransaction → RuleEvaluation → RecoveryOpportunity
///   → Case → Claim → Settlement → RecoveryLedgerEntry
model SourceTransaction {
  id             String         @id @default(uuid())
  organizationId String
  connectionId   String?
  importBatchId  String?
  domain         RecoveryDomain
  channel        Channel
  externalId     String?
  referenceType  String?
  occurredAt     DateTime?
  amount         Decimal?       @db.Decimal(18, 4)
  currency       String         @default("USD")
  /// 稳定幂等键，防止重复导入产生重复交易
  /// 生成：sha256(organizationId|connectionId|referenceType|externalId|rowFingerprint)
  dedupeKey      String
  raw            Json
  createdAt      DateTime       @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SourceConnection? @relation(fields: [connectionId], references: [id])
  importBatch  ImportBatch?      @relation(fields: [importBatchId], references: [id])
  evaluations  RuleEvaluation[]
  canonicalFactSources CanonicalFactSource[]
  shadowEvaluations    RuleEvaluationShadow[]

  @@unique([organizationId, dedupeKey])
  @@unique([organizationId, id])
  @@index([organizationId, channel, occurredAt])
  @@index([organizationId, externalId])
}

// ============================================================
// 三、核心业务实体
// ============================================================

/// C-0008-A 服务端会话：只存 tokenHash，租户边界由 Membership 复核 + 审计承担（不加 DB 触发器）
model Session {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  /// 最近一次令牌轮换时间（refresh / rotation 审计用）
  lastRotatedAt  DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  /// 原始 IP 永不落库，仅存哈希
  ipHash         String?
  userAgent      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

/// C-0008-A 邀请制入口（无公开注册）：令牌只存 hash，attemptCount 用于暴力尝试检测
model UserInvitation {
  id               String         @id @default(uuid())
  organizationId   String
  email            String
  role             MembershipRole @default(VIEWER)
  tokenHash        String         @unique
  expiresAt        DateTime
  createdBy        String
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  attemptCount     Int            @default(0)
  createdAt        DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@unique([organizationId, id])
  @@index([expiresAt])
}

/// 业务事实层（C-0006-A）：同一事实可以来自 FILE_UPLOAD 或 API，
/// 由 SourceTransaction 派生，Detection 未来只依赖这一层。
/// ACTIVE 可进入检测；CONFLICT 只进审计与对账复核，绝不进入 Detection / Opportunity。
model CanonicalFact {
  id                   String              @id @default(uuid())
  organizationId       String
  domain               RecoveryDomain
  channel              Channel
  /// REFERENCETYPE:EXTERNALID（统一大写），与 reconciliation 的事实键一致
  factKey              String
  referenceType        String?
  externalId           String?
  occurredAt           DateTime?
  amount               Decimal?            @db.Decimal(18, 4)
  currency             String              @default("USD")
  status               CanonicalFactStatus @default(ACTIVE)
  sourceCount          Int                 @default(0)
  confirmedAcrossModes Boolean             @default(false)
  firstSeenAt          DateTime            @default(now())
  lastUpdatedAt        DateTime            @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources      CanonicalFactSource[]
  evaluations  RuleEvaluation[]
  shadowEvaluations RuleEvaluationShadow[]

  @@unique([organizationId, factKey])
  @@unique([organizationId, id])
  @@index([organizationId, domain, channel, occurredAt])
  @@index([organizationId, status])
}

/// 事实 ↔ 原始行（溯源不被销毁）：原始数据永远保留在 SourceTransaction。
model CanonicalFactSource {
  id                  String                @id @default(uuid())
  organizationId      String
  canonicalFactId     String
  sourceTransactionId String
  /// 观测时的来源类型快照（连接被删除后仍可解释来源）
  connectionKind      SourceConnectionKind?
  /// 该来源什么时候观察到该事实（不使用 SourceTransaction.createdAt）
  observedAt          DateTime
  createdAt           DateTime              @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  canonicalFact     CanonicalFact     @relation(fields: [canonicalFactId], references: [id], onDelete: Cascade)
  sourceTransaction SourceTransaction @relation(fields: [sourceTransactionId], references: [id], onDelete: Cascade)

  @@unique([canonicalFactId, sourceTransactionId])
  @@index([organizationId, sourceTransactionId])
}

enum CanonicalFactStatus {
  ACTIVE
  CONFLICT
}

/// C-0006-B1 影子评估（只写结论，绝不进入 Opportunity / 资金链）
model RuleEvaluationShadow {
  id                          String               @id @default(uuid())
  organizationId              String
  /// 一次影子运行的标识，例如 shadow-run-20260928-001
  runId                       String
  /// 执行器版本（与业务规则版本 RuleVersion 区分）
  engineVersion               String
  ruleVersionId               String
  canonicalFactId             String
  /// 代表原始行，仅用于溯源；真正的身份键留到 B2
  representativeTransactionId String?
  result                      RuleEvaluationResult
  computed                    Json
  message                     String?
  evaluatedAt                 DateTime             @default(now())
  dedupeKeyShadow             String

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleVersion    RuleVersion        @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  canonicalFact  CanonicalFact      @relation(fields: [canonicalFactId], references: [id], onDelete: Cascade)
  representative SourceTransaction? @relation(fields: [representativeTransactionId], references: [id])

  @@unique([dedupeKeyShadow])
  @@unique([organizationId, id])
  @@index([organizationId, runId])
  @@index([organizationId, ruleVersionId, evaluatedAt])
  @@index([organizationId, canonicalFactId])
}

model RecoveryOpportunity {
  id                String            @id @default(uuid())
  organizationId    String
  domain            RecoveryDomain
  channel           Channel
  status            OpportunityStatus @default(DETECTED)
  opportunityType   String
  title             String
  description       String?
  amountExpected    Decimal?          @db.Decimal(18, 4)
  amountActual      Decimal?          @db.Decimal(18, 4)
  recoverableAmount Decimal?          @db.Decimal(18, 4)
  currency          String            @default("USD")
  confidence        Float?
  claimDeadline     DateTime?
  detectedAt        DateTime          @default(now())
  qualifiedAt       DateTime?
  rejectedReason    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evaluations   RuleEvaluation[]
  caseLinks     CaseOpportunity[]
  claimItems    ClaimItem[]
  routes        RecoveryRoute[]
  ledgerEntries RecoveryLedgerEntry[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, channel, detectedAt])
  @@index([organizationId, claimDeadline])
}

// ============================================================
// 四、图
// ============================================================

model RecoveryGraphNode {
  id             String        @id @default(uuid())
  organizationId String
  nodeType       GraphNodeType
  /// 多态引用：指向 nodeType 对应实体的主键。允许成为节点的实体见 DOMAIN_MODEL.md。
  refId          String?
  label          String
  properties     Json?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  outEdges RecoveryGraphEdge[] @relation("GraphFrom")
  inEdges  RecoveryGraphEdge[] @relation("GraphTo")

  /// 同租户内同类型同引用唯一 —— 防重复建点
  @@unique([organizationId, nodeType, refId])
  @@unique([organizationId, id])
  @@index([organizationId, refId])
}

model RecoveryGraphEdge {
  id             String        @id @default(uuid())
  organizationId String
  fromNodeId     String
  toNodeId       String
  edgeType       GraphEdgeType
  weight         Float?
  properties     Json?
  createdAt      DateTime      @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromNode     RecoveryGraphNode @relation("GraphFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode       RecoveryGraphNode @relation("GraphTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, edgeType])
  @@unique([organizationId, id])
  @@index([organizationId, edgeType])
}

// ============================================================
// 五、证据
// ============================================================

model EvidenceArtifact {
  id             String       @id @default(uuid())
  organizationId String
  kind           EvidenceKind
  fileAssetId    String?
  connectionId   String?
  externalUrl    String?
  title          String
  description    String?
  reliability    Float?
  capturedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset?        @relation(fields: [fileAssetId], references: [id])
  connection   SourceConnection? @relation(fields: [connectionId], references: [id])
  caseLinks    CaseEvidence[]
  settlements  Settlement[]
  outEdges     EvidenceEdge[]    @relation("EvidenceFrom")
  inEdges      EvidenceEdge[]    @relation("EvidenceTo")
  claimLinks   ClaimItemEvidence[]
  manualSubmissionLinks RecoveryManualSubmissionEvidence[]

  @@unique([organizationId, id])
  @@index([organizationId, kind])
  @@index([organizationId, fileAssetId])
}

model EvidenceEdge {
  id             String           @id @default(uuid())
  organizationId String
  fromId         String
  toId           String
  edgeType       EvidenceEdgeType
  note           String?
  createdAt      DateTime         @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  from         EvidenceArtifact @relation("EvidenceFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to           EvidenceArtifact @relation("EvidenceTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, edgeType])
  @@unique([organizationId, id])
  @@index([organizationId, edgeType])
}

/// §七.8：一份证据服务多个 Case —— 多对多
model CaseEvidence {
  organizationId String
  caseId         String
  evidenceId     String
  role           String?
  addedBy        String?
  addedAt        DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidence     EvidenceArtifact @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([caseId, evidenceId])
  @@index([organizationId, evidenceId])
}

// ============================================================
// 六、案件
// ============================================================

model Case {
  id              String         @id @default(uuid())
  organizationId  String
  caseNo          String
  title           String
  domain          RecoveryDomain
  status          CaseStatus     @default(OPEN)
  claimedAmount   Decimal?       @db.Decimal(18, 4)
  recoveredAmount Decimal        @default(0) @db.Decimal(18, 4)
  currency        String         @default("USD")
  ownerUserId     String?
  openedAt        DateTime       @default(now())
  closedAt        DateTime?
  dueAt           DateTime?
  workflowId      String?
  workflowRunId   String?
  nextActionAt    DateTime?
  aiSummary       Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities   CaseOpportunity[]
  evidence        CaseEvidence[]
  routes          RecoveryRoute[]
  claims          Claim[]
  appeals         Appeal[]
  settlements     Settlement[]
  ledgerEntries   RecoveryLedgerEntry[]
  billingInvoices BillingInvoice[]
  feeCalculations FeeCalculation[]
  claimItems      ClaimItem[]

  @@unique([organizationId, caseNo])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, nextActionAt])
  @@index([workflowId])
}

model CaseOpportunity {
  organizationId String
  caseId         String
  opportunityId  String
  note           String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  opportunity  RecoveryOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([caseId, opportunityId])
  @@index([organizationId, opportunityId])
}

model RecoveryRoute {
  id             String      @id @default(uuid())
  organizationId String
  caseId         String?
  opportunityId  String?
  target         RouteTarget
  status         RouteStatus @default(PROPOSED)
  rationale      String?
  ruleVersionId  String?
  decidedAt      DateTime?
  createdAt      DateTime    @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?                @relation(fields: [caseId], references: [id])
  opportunity  RecoveryOpportunity? @relation(fields: [opportunityId], references: [id])
  ruleVersion  RuleVersion?         @relation(fields: [ruleVersionId], references: [id])

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([caseId])
}

// ============================================================
// 七、申诉与复议
// ============================================================

model Claim {
  id             String      @id @default(uuid())
  organizationId String
  caseId         String
  round          Int         @default(1)
  status         ClaimStatus @default(DRAFT)
  target         RouteTarget
  externalRef    String?
  submittedAt    DateTime?
  submittedBy    String?
  dueAt          DateTime?
  respondedAt    DateTime?
  responseAmount Decimal?    @db.Decimal(18, 4)
  responseNote   String?
  aiDraftText    String?
  finalText      String?
  attachmentKey  String?
  /// S1（MSG-20260929-23）：平台侧案件号；与 externalRef（我方提交引用）语义分离
  platformCaseRef    String?
  /// S2：dueAt 的来源；无来源时 dueAt 必须为 null
  deadlineSource     ClaimDeadlineSource?
  /// S3：人工批准留痕（仅 OWNER/ADMIN 可写）
  approvedByUserId   String?
  approvedAt         DateTime?
  /// S4：终局原因（枚举；仅终局态可写）
  terminalReasonCode ClaimTerminalReasonCode?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  appeals      Appeal[]

  @@unique([organizationId, id])
  @@index([organizationId, caseId, round])
  @@index([dueAt, respondedAt])
  @@index([organizationId, status, dueAt])
}

model Appeal {
  id             String       @id @default(uuid())
  organizationId String
  claimId        String
  caseId         String
  round          Int          @default(2)
  status         AppealStatus @default(DRAFT)
  submittedAt    DateTime?
  externalRef    String?
  dueAt          DateTime?
  respondedAt    DateTime?
  outcomeAmount  Decimal?     @db.Decimal(18, 4)
  responseNote   String?
  aiDraftText    String?
  finalText      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claim        Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, claimId, round])
}

// ============================================================
// 八、规则引擎（全局规则 + 租户覆盖）
// ============================================================

/// ownerType=SYSTEM 为全局规则（organizationId 空，普通租户不可修改）；
/// ownerType=TENANT 归属某租户。
/// ownerKey 用于在数据库层保证唯一（PostgreSQL 唯一索引不约束 NULL）：
/// 租户规则填 organizationId，全局规则填字面量 'GLOBAL'。
model RuleSet {
  id             String         @id @default(uuid())
  ownerType      RuleOwnerType
  ownerKey       String
  organizationId String?
  domain         RecoveryDomain
  channel        Channel
  scope          RuleScope
  name           String
  description    String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     RuleVersion[]

  @@unique([ownerKey, channel, scope, name])
  @@index([organizationId, isActive])
  @@index([ownerType, channel, scope])
}

/// §七.16：至少含 source / version / effective_from / effective_to / last_verified
/// organizationId 为空表示继承自全局规则集。
model RuleVersion {
  id             String    @id @default(uuid())
  ruleSetId      String
  organizationId String?
  tier           RuleTier
  source         String
  version        String
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  lastVerified   DateTime?
  verifiedBy     String?
  definition     Json
  legalBasis     String?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleSet      RuleSet          @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  evaluations  RuleEvaluation[]
  shadowEvaluations RuleEvaluationShadow[]
  routes       RecoveryRoute[]
  claimItems   ClaimItem[]

  @@unique([ruleSetId, version, tier])
  @@unique([organizationId, id])
  @@index([effectiveFrom, effectiveTo])
  @@index([organizationId, isActive])
}

model RuleEvaluation {
  id                  String               @id @default(uuid())
  organizationId      String
  ruleVersionId       String
  sourceTransactionId String?
  canonicalFactId     String?
  opportunityId       String?
  result              RuleEvaluationResult
  computed            Json
  message             String?
  evaluatedAt         DateTime             @default(now())
  dedupeKey           String?
  /// C-0006-B2 业务事实身份键 = sha256(organizationId | ruleVersionId | canonicalFactId)；未映射历史行为 NULL
  canonicalDedupeKey  String?

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleVersion       RuleVersion          @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  sourceTransaction SourceTransaction?   @relation(fields: [sourceTransactionId], references: [id])
  opportunity       RecoveryOpportunity? @relation(fields: [opportunityId], references: [id])
  canonicalFact     CanonicalFact?       @relation(fields: [canonicalFactId], references: [id])

  @@unique([dedupeKey])
  @@unique([organizationId, id])
  /// 业务事实身份（长期唯一表达）；canonicalFactId 为 NULL 表示"无法建立业务事实身份"
  @@unique([organizationId, ruleVersionId, canonicalFactId])
  /// 二级完整性约束（hash 单列唯一，便于快速查询，不是核心身份）
  @@unique([canonicalDedupeKey])
  @@index([organizationId, ruleVersionId, evaluatedAt])
  @@index([organizationId, opportunityId])
  @@index([organizationId, canonicalFactId])
  @@index([organizationId, canonicalDedupeKey])
}

// ============================================================
// 九、到账与账本
// ============================================================

model Settlement {
  id             String           @id @default(uuid())
  organizationId String
  caseId         String?
  status         SettlementStatus @default(EXPECTED)
  source         SettlementSource
  amount         Decimal          @db.Decimal(18, 4)
  currency       String           @default("USD")
  receivedAt     DateTime?
  externalRef    String?
  /// 到账必须能追到证据（真实关联，不悬空）
  evidenceId     String?
  confirmedBy    String?
  confirmedAt    DateTime?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  /// MSG-20260929-26 R1a：业务确认轴（是否被人工确认为事实）—— 与到账轴互不覆盖
  confirmationStatus     SettlementConfirmationStatus   @default(CONFIRMED)
  /// MSG-20260929-26 R1b：到账对账轴（钱是否真的到账、到了多少、是否有问题）
  reconciliationStatus   SettlementReconciliationStatus @default(NOT_STARTED)
  /// MSG-20260929-26 R2a：业务确认留痕（R2b 的 confirmedAt 复用既有列）
  confirmedByUserId      String?
  /// MSG-20260929-26 R4：冲回链（不删除原记录；财务处置由 FINANCE 人工完成，D3）
  reversedBySettlementId String?

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case            Case?                 @relation(fields: [caseId], references: [id])
  evidence        EvidenceArtifact?     @relation(fields: [evidenceId], references: [id])
  ledgerEntries   RecoveryLedgerEntry[]
  feeCalculations FeeCalculation[]
  payouts         RecoveryPayout[]
  reversedBy      Settlement?           @relation("SettlementReversal", fields: [reversedBySettlementId], references: [id])
  reversals       Settlement[]          @relation("SettlementReversal")

  @@unique([organizationId, id])
  @@index([organizationId, status, receivedAt])
  @@index([organizationId, confirmationStatus])
  @@index([organizationId, reconciliationStatus])
  @@index([caseId])
}

/// 账本分录。**只增不改**：纠错靠 REVERSAL + voidsEntryId。
/// §七.2/§七.3：与 SourceTransaction 严格分离。
model RecoveryLedgerEntry {
  id             String          @id @default(uuid())
  organizationId String
  caseId         String?
  opportunityId  String?
  settlementId   String?
  entryType      LedgerEntryType
  amount         Decimal         @db.Decimal(18, 4)
  currency       String          @default("USD")
  occurredAt     DateTime        @default(now())
  counterparty   String?
  reference      String?
  voidsEntryId   String?
  voidedAt       DateTime?
  voidedBy       String?
  voidReason     String?
  createdBy      String?
  createdAt      DateTime        @default(now())

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case            Case?                 @relation(fields: [caseId], references: [id])
  opportunity     RecoveryOpportunity?  @relation(fields: [opportunityId], references: [id])
  settlement      Settlement?           @relation(fields: [settlementId], references: [id])
  voids           RecoveryLedgerEntry?  @relation("LedgerVoids", fields: [voidsEntryId], references: [id])
  voidedByEntries RecoveryLedgerEntry[] @relation("LedgerVoids")

  @@unique([organizationId, id])
  @@index([organizationId, occurredAt])
  @@index([organizationId, entryType])
  @@index([caseId])
}

// ============================================================
// 十、收费
// ============================================================

model BillingInvoice {
  id             String        @id @default(uuid())
  organizationId String
  caseId         String?
  invoiceNo      String
  status         BillingStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(18, 4)
  taxAmount      Decimal       @default(0) @db.Decimal(18, 4)
  total          Decimal       @db.Decimal(18, 4)
  currency       String        @default("USD")
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  paidAmount     Decimal       @default(0) @db.Decimal(18, 4)
  externalRef    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?            @relation(fields: [caseId], references: [id])
  fees         FeeCalculation[]
  payments     Payment[]

  @@unique([organizationId, invoiceNo])
  @@unique([organizationId, id])
  @@index([organizationId, status, dueAt])
}

/// 成功费计算。可追溯链：Settlement → FeeCalculation → BillingInvoice
model FeeCalculation {
  id               String   @id @default(uuid())
  organizationId   String
  billingInvoiceId String?
  settlementId     String?
  caseId           String?
  basis            FeeBasis
  rate             Decimal? @db.Decimal(9, 6)
  baseAmount       Decimal  @db.Decimal(18, 4)
  feeAmount        Decimal  @db.Decimal(18, 4)
  currency         String   @default("USD")
  computation      Json
  calculatedAt     DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingInvoice BillingInvoice? @relation(fields: [billingInvoiceId], references: [id], onDelete: Cascade)
  settlement     Settlement?     @relation(fields: [settlementId], references: [id])
  case           Case?           @relation(fields: [caseId], references: [id])

  @@unique([organizationId, id])
  @@index([organizationId, billingInvoiceId])
  @@index([organizationId, settlementId])
}

// ============================================================
// 十一、审计
// ============================================================

model AuditLog {
  id             String         @id @default(uuid())
  /// 审计永远归属租户：平台级全局日志不共用本表（CHANGE #24）
  organizationId String
  actorType      AuditActorType
  /// USER 时的用户 id —— 保数据库引用完整性（FK → User.id）
  actorUserId    String?
  /// 非 USER actor 的身份（服务名 / 模型名 / 外部系统名），不指向 User
  actorRef       String?
  action         String
  entityType     String?
  entityId       String?
  changes        Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime       @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([actorUserId])
}

// ============================================================
// C-0010 Payment Integration（客户向我方支付服务费的事实）
// ------------------------------------------------------------
// 与 Settlement（第三方赔付给客户）严格分离；BillingInvoice 不承载支付语义。
// ============================================================

enum PaymentStatus {
  CREATED
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentEventResult {
  PROCESSED
  IGNORED
  REJECTED
  DUPLICATE
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  invoiceId         String
  provider          String
  externalPaymentId String
  amount            Decimal       @db.Decimal(18, 4)
  currency          String        @default("USD")
  status            PaymentStatus @default(CREATED)
  idempotencyKey    String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      BillingInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  attempts     PaymentProcessingAttempt[]

  @@unique([organizationId, provider, externalPaymentId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([invoiceId])
}

/// 只保存事件元数据（eventId/type/payloadHash/结果）；绝不存完整 payload 或卡数据。
model PaymentEvent {
  id               String             @id @default(uuid())
  organizationId   String
  provider         String
  providerEventId  String
  eventType        String
  payloadHash      String
  receivedAt       DateTime           @default(now())
  processingResult PaymentEventResult

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempts     PaymentProcessingAttempt[]

  @@unique([provider, providerEventId])
  @@unique([organizationId, id])
  @@index([organizationId, receivedAt])
}

enum PaymentAttemptStatus {
  PENDING
  RUNNING
  SUCCEEDED
  RETRYABLE_FAILED
  DEAD_LETTER
}

/// C-0010-B2：一次「执行尝试」= 把不可变的 PaymentEvent 变成 Payment / 账单状态的尝试
/// 与 PaymentEvent 同为 append-only；不变量由部分唯一索引与 Payment 唯一键保证。
model PaymentProcessingAttempt {
  id             String   @id @default(uuid())
  organizationId String
  paymentEventId String
  attemptNo      Int
  status         PaymentAttemptStatus @default(PENDING)
  /// 与 applyPaymentSucceeded 返回对齐：PAID / PENDING_REVIEW / AMOUNT_MISMATCH / ILLEGAL_TRANSITION
  resultStatus   String?
  /// 仅白名单：DATABASE_TIMEOUT / CAS_CONFLICT / UNKNOWN_PROVIDER_RESPONSE
  errorCode      String?
  /// 只允许白名单代码与短句；禁止 payload / 签名 / token / 卡数据 / 客户机密
  errorSummary   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  /// 退避用「下次可重试时间」表达，不需要守护进程
  nextRetryAt    DateTime?
  /// EXTERNAL / SYSTEM / OPERATOR（应用层白名单）
  actorType      String
  actorRef       String?
  createdAt      DateTime @default(now())
  paymentId      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentEvent PaymentEvent @relation(fields: [paymentEventId], references: [id], onDelete: Cascade)
  /// C-0010-B2 addendum：执行成功时回填；PENDING 阶段为 null
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, paymentEventId, attemptNo])
  @@unique([organizationId, id])
  @@index([organizationId, status, nextRetryAt])
  @@index([paymentEventId])
}

// ============================================================
// C-0011 — 损失事件归一化（ClaimItem）与证据联结（ClaimItemEvidence）
// 约束（MSG-20260928-116 / -118）：
//   · 一个 Case 聚合多条 ClaimItem（方案 B）；caseId 在 REVIEW_REQUIRED 之后必须存在，
//     但这是**状态机不变量**，刻意不加数据库 CHECK。
//   · 不复制证据文件：只建 ClaimItem ↔ EvidenceArtifact 联结。
//   · Schema 内不出现任何平台写权限字段（token / credential / oauth）——凭据只属于 SourceConnection。
// ============================================================

enum ClaimItemStatus {
  DISCOVERED
  VERIFIED
  REVIEW_REQUIRED
  READY_TO_APPEAL
  SUBMITTED_MANUAL
  RECOVERED
  CLOSED
}

/// 关闭用原因表达，不增加状态数量（MSG-20260928-114 REVISE-1）。
enum ClaimItemClosedReason {
  RECOVERED
  REJECTED
  NOT_WORTH_PURSUING
  CUSTOMER_DECLINED
}

enum ClaimResponsibleParty {
  CARRIER
  PLATFORM
  PLATFORM_WAREHOUSE
  SELLER
  BUYER
  THIRD_PARTY
  UNKNOWN
}

enum ClaimEvidenceType {
  POD
  INVOICE
  LEDGER_EXPORT
  ADJUSTMENT_REPORT
  TRACKING
  PLATFORM_DECISION
  CLAIM_RESPONSE
  CONTRACT_TERM
  OTHER
}

model ClaimItem {
  id               String   @id @default(uuid())
  organizationId   String
  /// REVIEW_REQUIRED 起必须存在（服务层不变量，不用数据库 CHECK）
  caseId           String?
  opportunityId    String?
  /// AMAZON | TIKTOK | WALMART | UNKNOWN（应用层白名单）
  platformType     String
  claimType        String
  /// 平台侧唯一引用；为空时该行不享受自动幂等（未来由 sourceFingerprint 关闭缺口）
  platformRef      String?
  /// C-0013-A：来源指纹（与 platformRef 二选一去重；**不含金额**，平台更正不会拆单）
  sourceFingerprint String?
  /// 指纹算法版本（当前恒为 v1）；sourceFingerprint 非空时必须非空
  fingerprintVersion String?
  occurredAt       DateTime
  amountExpected   Decimal? @db.Decimal(18, 4)
  amountActual     Decimal? @db.Decimal(18, 4)
  currency         String   @default("USD")
  /// 由既有 Rule Engine 产出，本模型不定义算法
  recoverableAmount Decimal? @db.Decimal(18, 4)
  responsibleParty ClaimResponsibleParty @default(UNKNOWN)
  status           ClaimItemStatus @default(DISCOVERED)
  closedReason     ClaimItemClosedReason?
  closedAt         DateTime?
  /// 归一化器版本，用于回溯「当时是谁归一化的」
  normalizerVersion String
  /// 规则版本，用于回溯「当时用哪版规则算出的可追回金额」
  ruleVersionId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?               @relation(fields: [caseId], references: [id])
  opportunity  RecoveryOpportunity? @relation(fields: [opportunityId], references: [id])
  ruleVersion  RuleVersion?        @relation(fields: [ruleVersionId], references: [id])
  evidenceLinks ClaimItemEvidence[]
  recoveryPackages  RecoveryPackage[]
  manualSubmissions RecoveryManualSubmission[]
  // R45 S1
  expectedRecoveryBases   ExpectedRecoveryBasis[]
  reconciliationOverrides ReconciliationOverrideDecision[]
  reconciliationProjections ClaimReconciliationProjection[]

  @@unique([organizationId, platformType, platformRef, claimType])
  @@unique([organizationId, id])
  @@index([organizationId, status, occurredAt])
  @@index([caseId])
}

model ClaimItemEvidence {
  id             String   @id @default(uuid())
  organizationId String
  claimItemId    String
  evidenceId     String
  evidenceType   ClaimEvidenceType @default(OTHER)
  note           String?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimItem    ClaimItem       @relation(fields: [claimItemId], references: [id], onDelete: Cascade)
  evidence     EvidenceArtifact @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, claimItemId, evidenceId])
  @@unique([organizationId, id])
  @@index([claimItemId])
}

// ============================================================
// 十一、回收确认（Recovery Confirmation）—— MSG-20260929-26
// 两条互不覆盖的事实轴；到账事实唯一来源；金额口径零改动。
// ============================================================

/// 业务确认轴：这笔回收是否已被人工确认为事实（与到账对账解耦）
enum SettlementConfirmationStatus {
  CONFIRMED
  PENDING_CONFIRMATION
  REJECTED_BY_REVIEW
}

/// 到账对账轴：平台/银行到账与确认金额的对齐进度
enum SettlementReconciliationStatus {
  NOT_STARTED
  PARTIAL
  RECONCILED
  DISPUTED
  REVERSED
}

/// 到账事实的唯一来源：金额只存在这里；
/// receivedAmount = Σ RecoveryPayout.amount 为**投影**，不落库（避免第二份金额事实源）。
model RecoveryPayout {
  id             String   @id @default(uuid())
  organizationId String
  settlementId   String
  /// 平台/银行到账引用（幂等键）
  payoutRef      String
  amount         Decimal  @db.Decimal(18, 4)
  currency       String   @default("USD")
  receivedAt     DateTime
  /// PLATFORM_SETTLEMENT / BANK_TRANSFER / OTHER（服务层白名单，不新增 TYPE）
  sourceType     String
  createdBy      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlement   Settlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([organizationId, payoutRef])
  @@unique([organizationId, id])
  @@index([organizationId, receivedAt])
  @@index([organizationId, settlementId])
}


// ============================================================
// 十二、控制面（Kill Switch 变更请求）—— MSG-20260929-57 / -59
// ------------------------------------------------------------
// 已批准范围（MSG-20260929-59 A1）：新表 / 新枚举 / 新索引 / 新租户触发器 /
// Organization 反向关系。**不修改** Claim / Settlement / Billing / Submission /
// AuditLog 既有字段，也不引入任何自动动作。
//
// 语义（MSG-20260929-57 D1/D4 + MSG-20260929-56）：
//   · 开启：PENDING_ENABLE →（另一 OWNER/ADMIN 确认）→ APPLIED
//   · 拉闸：target=DISABLED 直接落 APPLIED（无 pending 阶段）
//   · 终态不可回退（APPLIED / EXPIRED / CANCELLED）
//   · 本表只记录控制面请求事实；资金与业务事实（Settlement / Ledger / Billing）零触碰
// ============================================================

enum KillSwitchTarget {
  ENABLED
  DISABLED
}

/// 请求生命周期。APPLIED / EXPIRED / CANCELLED 为终态。
enum KillSwitchRequestState {
  PENDING_ENABLE
  APPLIED
  EXPIRED
  CANCELLED
}

model KillSwitchRequest {
  id             String                 @id @default(uuid())
  organizationId String
  /// 目标作用域（例如 "global" / 通道名）；同租户同 scope 只允许一条 PENDING_ENABLE
  scope          String
  target         KillSwitchTarget
  state          KillSwitchRequestState @default(PENDING_ENABLE)
  reasonCode     String
  /// 运营用途（≤200 字符，拒绝凭据样式）；审计快照另存于 AuditLog.changes
  note           String?
  /// actorUserId（同租户成员）
  requestedBy    String
  requestedAt    DateTime               @default(now())
  /// requestedAt + 15min；过期后不得确认（惰性置 EXPIRED）
  expiresAt      DateTime
  /// 仅另一 OWNER/ADMIN 可确认；服务端强制 confirmedBy !== requestedBy
  confirmedBy    String?
  confirmedAt    DateTime?
  /// 实际落地时间（target=DISABLED 的请求直接带此时间落 APPLIED）
  appliedAt      DateTime?
  /// 幂等键：同租户重复提交返回首次结果，不重复写审计
  idempotencyKey String
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
  /// 普通索引（「同 scope 仅一个 PENDING_ENABLE」由迁移中的部分唯一索引保证）
  @@index([organizationId, scope, state])
  @@index([expiresAt])
}

// ============================================================
// C-PLATFORM-WRITE-LEDGER — 持久化执行账本（MSG-20261001-19 授权）
// ------------------------------------------------------------
// 约束/索引按 M1 → M2 → M3 三步落地：
//   M1（本迁移）：新增枚举 + 新增表（无唯一约束、无索引）
//   M2：C1 幂等键唯一、C2 approval 唯一、C4–C6 查询索引
//   M3：C3 SUCCEEDED partial unique index（迁移内 raw SQL）
// 硬边界：不接线 HTTP、不接真实 adapter、transport 恒关；
//         账本禁止存放 credential / token / secret / 原始平台 payload。
// ============================================================

enum PlatformWriteAttemptStatus {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  RETRYABLE
  FAILED
  DEAD_LETTER
  BLOCKED
  UNKNOWN_PROVIDER_RESPONSE
  RECONCILING
  FAILED_CONFIRMED
  MANUAL_REVIEW
}

model PlatformWriteAttempt {
  id                 String                      @id @default(uuid())
  organizationId     String
  /// 受保护动作名（单一来源常量 platform.write）
  action             String
  /// 服务端提交快照版本（platform-write-request/v1）
  snapshotVersion    String
  /// 服务端提交快照摘要（64 hex）
  snapshotDigest     String
  /// 幂等键 pw1-*（同一逻辑提交恒定）
  idempotencyKey     String
  /// 同一逻辑执行链内的投递/对账计数（不产生第二条可独立成功的链）
  attemptNo          Int                         @default(1)
  status             PlatformWriteAttemptStatus  @default(PENDING)
  /// CLAIM / APPEAL（应用层枚举；弱引用，不建 FK）
  targetKind         String
  targetId           String
  platform           String
  /// 是否模拟通道；真实通道必须显式为 false 才允许真实调用
  simulated          Boolean                     @default(true)
  /// 审批事件 id（AuditLog.id；非 FK，仅引用 + 复制摘要事实）
  approvalId         String?
  /// 审批绑定的快照摘要，必须等于 snapshotDigest
  basisReference     String?
  errorClass         String?
  errorCode          String?
  /// 限长短句；禁止 payload / token / secret
  errorSummary       String?
  startedAt          DateTime?
  finishedAt         DateTime?
  nextRetryAt        DateTime?
  providerRef        String?
  reconcileAttempts  Int                         @default(0)
  reconcileNextAt    DateTime?
  reconcileLastActor String?
  /// CONFIRMED_SUCCEEDED / CONFIRMED_FAILED / INCONCLUSIVE
  reconciledStatus   String?
  reconciledAt       DateTime?
  /// SYSTEM / USER
  convergedBy        String?
  convergedReason    String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// C1：同一幂等键 = 唯一逻辑执行链（MSG-20261001-18 裁决①选 A）
  @@unique([organizationId, idempotencyKey])
  /// C2：一个非空 approvalId 最多绑定一个能取得真实执行权的 attempt（NULL 不冲突）
  @@unique([organizationId, approvalId])
  /// C4：重试扫描
  @@index([organizationId, status, nextRetryAt])
  /// C5：对账扫描
  @@index([organizationId, status, reconcileNextAt])
  /// C6：按对象回看执行链
  @@index([organizationId, targetKind, targetId])
  /// C6b：审计对齐
  @@index([organizationId, createdAt])
}

// ============================================================
// 十三、人工追回提交（Manual Recovery Handoff）—— R43 / MSG-20261001-31 / -32
// 四事实分离：package generated ≠ human submitted ≠ provider accepted ≠ reimbursed
// 业务真值 = ClaimItem.status + RecoveryManualSubmission；AuditLog 仅 append-only 证据。
// ============================================================

/// 材料包生命周期：只表达「材料包本身」，不含任何「已提交 / 已受理 / 已赔付」语义。
/// EXPORTED 表示「发生过导出」这一事实（**非终态**）；终态仅 SUPERSEDED / WITHDRAWN。
enum RecoveryPackageStatus {
  GENERATED
  EXPORTED
  SUPERSEDED
  WITHDRAWN
}

/// 导出产物形态：JSON manifest 为规范事实载体，PDF 为 human-readable derivative。
enum RecoveryPackageArtifactKind {
  PDF
  JSON_MANIFEST
}

/// 人工提交材料包（服务端生成、带 digest 与版本；审批与提交的绑定锚点）
model RecoveryPackage {
  id                    String                 @id @default(uuid())
  organizationId        String
  claimItemId           String
  /// 与 ClaimItem.caseId 一致（服务层校验；弱引用，不建 FK）
  caseId                String?
  /// 内容结构版本（recovery-package/v1）
  packageVersion        String
  /// digest 算法版本（当前恒为 v1，显式落库以便历史可比）
  digestVersion         String
  /// sha256(canonical manifest)，64 hex；创建后不可修改
  packageDigest         String
  /// 见 enum 注释：EXPORTED 非终态；终态仅 SUPERSEDED / WITHDRAWN
  status                RecoveryPackageStatus @default(GENERATED)
  /// required/optional/missing 只读投影快照（白名单字段，无原始客户/凭据内容）
  completenessSnapshot  Json?
  generatedByUserId     String?
  generatedAt           DateTime               @default(now())
  /// 新 digest 取代旧包（弱引用）
  supersededByPackageId String?
  /// SUPERSEDED / WITHDRAWN 必须带 reason + actor + 审计
  transitionReason      String?
  transitionActorUserId String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimItem    ClaimItem              @relation(fields: [claimItemId], references: [id], onDelete: Cascade)
  artifacts    RecoveryPackageArtifact[]
  submissions  RecoveryManualSubmission[]

  /// 同一输入的包只有一份
  @@unique([organizationId, claimItemId, packageVersion, packageDigest])
  @@unique([organizationId, id])
  @@index([organizationId, claimItemId, status])
  @@index([organizationId, createdAt])
}

/// 导出产物（append-only）：只引用既有 FileAsset，不复制证据/存储
model RecoveryPackageArtifact {
  id               String                      @id @default(uuid())
  organizationId   String
  packageId        String
  artifactKind     RecoveryPackageArtifactKind
  /// 只引用既有文件资产
  fileAssetId      String
  /// 必须与 FileAsset.sha256 一致（服务层校验）
  sha256           String
  exportedByUserId String?
  exportedAt       DateTime                    @default(now())
  createdAt        DateTime                    @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package      RecoveryPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset       @relation(fields: [fileAssetId], references: [id])

  /// 同内容重复导出不新增第二份 artifact
  @@unique([organizationId, packageId, artifactKind, sha256])
  @@unique([organizationId, id])
  @@index([organizationId, packageId, exportedAt])
}

/// 人工提交事实（② 用户已提交）：业务事实，非审计日志；append-only
model RecoveryManualSubmission {
  id                     String   @id @default(uuid())
  organizationId         String
  claimItemId            String
  /// 必须与 ClaimItem.caseId 一致；跨案件绑定一律拒绝
  caseId                 String
  packageId              String
  /// 必须等于 RecoveryPackage.packageDigest（同事务校验）
  packageDigest          String
  /// 审批事件 id（recovery.review_approved.id；非 FK，仅引用 + 复制摘要事实）
  /// 受保护动作下提交记录必然由审批消费产生 —— 不保留无审批提交路径
  approvalId             String
  /// rmp1:<claimItemId>:<caseId>:<packageVersion>:<digestVersion>:<packageDigest>
  approvalBasisReference String
  submittedAt            DateTime
  submittedByUserId      String
  /// rms1-<claimItemId>
  idempotencyKey         String
  note                   String?
  createdAt              DateTime @default(now())

  organization  Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimItem     ClaimItem                           @relation(fields: [claimItemId], references: [id], onDelete: Cascade)
  package       RecoveryPackage                     @relation(fields: [packageId], references: [id])
  references    RecoveryManualSubmissionReference[]
  evidenceLinks RecoveryManualSubmissionEvidence[]

  /// v1 单链：一个 ClaimItem 至多一条逻辑提交事实
  @@unique([organizationId, claimItemId])
  /// CHANGE B：同一个 approval 不得授权两条 manual submission
  @@unique([organizationId, approvalId])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([organizationId, submittedAt])
}

/// provider case reference 事实（append-only，第五张表）：
/// 人工提交后补录的引用；Submission 本体保持完全 immutable（不得在 Submission 上 UPDATE）。
model RecoveryManualSubmissionReference {
  id                        String   @id @default(uuid())
  organizationId            String
  submissionId              String
  /// 用户原始输入（展示 / 审计）
  providerCaseRefRaw        String
  /// 规范身份：trim → NFKC → 去零宽 → 折叠空白（**不做大小写折叠**）
  providerCaseRefCanonical  String
  /// 产生该补录事实的审批事件 id（可空：补录为受保护动作时非空）
  approvalId                String?
  recordedAt                DateTime @default(now())
  recordedByUserId          String
  note                      String?
  createdAt                 DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   RecoveryManualSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// 同一租户内 canonical 引用唯一（补录不得把同一平台引用绑到两处）
  @@unique([organizationId, providerCaseRefCanonical])
  @@unique([organizationId, id])
  @@index([organizationId, submissionId])
}

/// 提交时附带的证据引用（联结表，append-only）：只引用既有 EvidenceArtifact
model RecoveryManualSubmissionEvidence {
  id             String             @id @default(uuid())
  organizationId String
  submissionId   String
  evidenceId     String
  note           String?
  createdAt      DateTime           @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   RecoveryManualSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  evidence     EvidenceArtifact          @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, submissionId, evidenceId])
  @@unique([organizationId, id])
}

// ============================================================
// R45 S1（MSG-20261001-45 / MSG-20261001-46）
// Outcome / Reimbursement Reconciliation —— 七表模型
//   Facts / Basis / Policy / Override 为不可变事实；Projection 为 derived materialization。
// 边界：NO Settlement · NO Billing · NO Fee · NO RecoveryLedger mutation · NO platform write。
// 数据库级不变量（触发器 / partial unique / CHECK）见 M2–M5 迁移；Prisma 无法表达的部分
// 以原生 SQL 落库（与既有 partial index 惯例一致）。
// ============================================================

/// provider 受理 / 撤销事实（Immutable，append-only）。
/// 撤销以**新事实**表达，绝不改写历史 ACCEPTED（MSG-20261001-44 Q4）。
model ProviderOutcomeFact {
  id                       String                     @id @default(uuid())
  organizationId           String
  /// 弱引用（与 R43 同口径，不建 FK）
  caseId                   String
  claimItemId              String?
  /// 平台 / 承运商标识（参与指纹输入与 reversal 同源性校验）
  provider                 String
  kind                     ProviderOutcomeFactKind
  /// 复用 R43 S4 canonical（服务端构造）
  providerCaseRefCanonical String?
  /// provider 侧事件时间
  occurredAt               DateTime
  /// provider 原生稳定事件 ID（可空：并非所有来源都提供）
  providerEventId          String?
  /// 版本化服务端指纹（CHANGE B）：64 hex
  providerEventFingerprint String
  /// 指纹算法版本（当前恒为 v1）
  fingerprintVersion       String                     @default("v1")
  /// 来源类型；人工录入必须 MANUAL_WITH_EVIDENCE 且带 ≥1 证据（受保护路径，Q④）
  sourceKind               ProviderOutcomeSourceKind
  sourceRef                String
  capturedAt               DateTime
  parserVersion            String?
  ingestedByUserId         String
  /// 只引用既有 EvidenceArtifact（不复制证据仓库）
  evidenceArtifactIds      String[]
  reasonCode               String?
  note                     String?
  createdAt                DateTime                   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// ingest 幂等：同一租户同一指纹只允许一条事实（重复 ingest 复用既有事实，不双计）
  @@unique([organizationId, providerEventFingerprint])
  @@unique([organizationId, id])
  @@index([organizationId, claimItemId, occurredAt])
  @@index([organizationId, providerCaseRefCanonical])
}

/// 赔付观察 / 冲正事实（Immutable，append-only）。
/// CHANGE A（MSG-20261001-46）：`OBSERVED.amount > 0`；冲正行**不携带独立金额语义**（amount IS NULL），
/// 金额一律由 `reversesFactId` 指向的事实取得。v1 仅支持 full reversal。
model ReimbursementFact {
  id                       String                  @id @default(uuid())
  organizationId           String
  claimItemId              String?
  caseId                   String?
  provider                 String
  kind                     ReimbursementFactKind
  /// 被冲正的 OBSERVED 事实（同租户 / 同 provider / 同 currency；不得自指）
  reversesFactId           String?
  /// 仅 OBSERVED 行有值（CHECK 保证）
  amount                   Decimal?                @db.Decimal(18, 4)
  currency                 String
  occurredAt               DateTime
  providerEventId          String?
  /// CHANGE B：冲正自身也是 provider event，必须有自己的指纹
  providerEventFingerprint String
  fingerprintVersion       String                  @default("v1")
  providerCaseRefCanonical String?
  orderRef                 String?
  rawRefs                  Json?
  sourceKind               ReimbursementSourceKind
  sourceRef                String
  capturedAt               DateTime
  parserVersion            String?
  ingestedByUserId         String
  evidenceArtifactIds      String[]
  reasonCode               String?
  note                     String?
  createdAt                DateTime                @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reversesFact ReimbursementFact?  @relation("ReimbursementReversal", fields: [reversesFactId], references: [id])
  reversedBy   ReimbursementFact[] @relation("ReimbursementReversal")
  projectionMembers ClaimReconciliationProjectionFact[]
  overrideDecisions ReconciliationOverrideDecision[]

  @@unique([organizationId, providerEventFingerprint])
  @@unique([organizationId, id])
  @@index([organizationId, claimItemId, occurredAt])
  @@index([organizationId, providerCaseRefCanonical])
}

/// 期望可追回基准（版本化 Immutable；仅允许受控 supersede）。
/// CHANGE C（MSG-20261001-45）：effective 由 `supersededAt IS NULL` 判定，
/// partial unique 仅作最终防线；supersede 必须在**同一事务**内按 CAS 顺序执行。
model ExpectedRecoveryBasis {
  id                     String                    @id @default(uuid())
  organizationId         String
  claimItemId            String
  caseId                 String
  expectedRecoveryAmount Decimal                   @db.Decimal(18, 4)
  currency               String
  basisKind              ExpectedRecoveryBasisKind
  /// 基准版本（版本化）
  basisVersion           String
  /// 依据来源（文档 / 报告 / 人工，含证据引用）
  basisSource            String
  effectiveAt            DateTime
  createdByUserId        String
  createdAt              DateTime                  @default(now())
  /// null = effective；受控 supersede 时置为时间（白名单仅此两列）
  supersededAt           DateTime?
  supersededByBasisId    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimItem    ClaimItem    @relation(fields: [claimItemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, claimItemId, supersededAt])
}

/// 对账人工覆盖决策（Immutable，append-only）：v1 每笔 reimbursement 单独审批（MSG-20261001-44 Q⑤）。
model ReconciliationOverrideDecision {
  id                  String                            @id @default(uuid())
  organizationId      String
  claimItemId         String
  reimbursementFactId String
  decisionKind        ReconciliationOverrideDecisionKind
  reasonCode          String
  reasonText          String
  /// 必填：recovery.review_approved 事件 id（humanApproval）
  approvalId          String
  decidedByUserId     String
  decidedAt           DateTime
  createdAt           DateTime                          @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimItem         ClaimItem         @relation(fields: [claimItemId], references: [id], onDelete: Cascade)
  reimbursementFact ReimbursementFact @relation(fields: [reimbursementFactId], references: [id], onDelete: Cascade)

  /// v1：一笔 reimbursement 至多一条覆盖决策
  @@unique([organizationId, reimbursementFactId])
  /// 同一 approval 不得授权两条覆盖决策
  @@unique([organizationId, approvalId])
  @@unique([organizationId, id])
  @@index([organizationId, claimItemId])
}

/// 对账投影（derived materialization / 可重算缓存，**不是**不可逆历史事实）。
/// MSG-20261001-46 Q3：重算 = 同事务整体替换；DELETE 仅限 derived ProjectionFact。
model ClaimReconciliationProjection {
  id                       String                       @id @default(uuid())
  organizationId           String
  claimItemId              String
  status                   ReconciliationProjectionStatus
  /// 本次计算使用的 effective 基准（可追溯）
  basisId                  String?
  expectedAmount           Decimal?                     @db.Decimal(18, 4)
  currency                 String?
  /// 有效且未被冲正抵销的已匹配金额
  netMatchedObservedAmount Decimal                      @default(0) @db.Decimal(18, 4)
  /// 摘要缓存；一致性以关系表 ClaimReconciliationProjectionFact 为准（checker 校验）
  matchedFactIds           String[]
  /// CHANGE C：每个投影必须能引用实际使用的策略（不得代码隐式 fallback）
  tolerancePolicyId        String
  policyVersion            String
  /// 输入摘要（sha256，64 hex）
  inputDigest              String
  /// 投影版本（单调 +1；与成员关系 generation 绑定）
  projectionVersion        Int                          @default(1)
  computedAt               DateTime
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  organization Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimItem    ClaimItem                           @relation(fields: [claimItemId], references: [id], onDelete: Cascade)
  members      ClaimReconciliationProjectionFact[]

  @@unique([organizationId, claimItemId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

/// 投影成员关系（derived 关联，CHANGE A / D）：事实成员关系不得只存 JSON。
/// 每行绑定具体的 projection generation（projectionVersion），
/// 提交时全会话一致（DEFERRABLE 约束触发器）；重算时同一事务整体替换。
model ClaimReconciliationProjectionFact {
  id                  String   @id @default(uuid())
  organizationId      String
  projectionId        String
  /// CHANGE A：成员关系必须绑定 projection 版本
  projectionVersion   Int
  reimbursementFactId String
  createdAt           DateTime @default(now())

  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projection        ClaimReconciliationProjection   @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  reimbursementFact ReimbursementFact               @relation(fields: [reimbursementFactId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectionId, projectionVersion, reimbursementFactId])
  @@unique([organizationId, id])
  @@index([organizationId, projectionId])
}

/// 对账容差策略（Immutable / versioned；append-only）。
/// CHANGE C（MSG-20261001-46）：scope = provider + operation/resource + version，
/// 同一 scope 只能有一个 effective policy；无 provider-specific policy 时使用
/// **显式系统 exact policy 记录**（provider / operation 为空），不得代码隐式 fallback。
model ReconciliationTolerancePolicy {
  id                String    @id @default(uuid())
  /// 空 = 系统级（跨租户显式常量记录）
  organizationId    String?
  provider          String?
  operation         String?
  policyVersion     String
  absoluteTolerance Decimal   @default(0) @db.Decimal(18, 4)
  relativeTolerance Decimal   @default(0) @db.Decimal(9, 6)
  effectiveAt       DateTime
  createdByUserId   String
  createdAt         DateTime  @default(now())
  supersededAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, provider, operation])
}

enum ProviderOutcomeFactKind {
  ACCEPTED
  ACCEPTANCE_REVOKED
}

/// 人工录入不存在「客户端自证」取值：人工路径恒为 MANUAL_WITH_EVIDENCE（Q④）
enum ProviderOutcomeSourceKind {
  OFFICIAL_API
  PLATFORM_REPORT
  MANUAL_WITH_EVIDENCE
}

enum ReimbursementFactKind {
  OBSERVED
  REIMBURSEMENT_REVERSED
}

enum ReimbursementSourceKind {
  OFFICIAL_API
  PLATFORM_REPORT
  MANUAL_WITH_EVIDENCE
}

/// 基准种类（R45-A §2.3 列出的三种；新增种类需另一次 Schema 变更）
enum ExpectedRecoveryBasisKind {
  CARRIER_CLAIM
  PROVIDER_POLICY
  CONTRACTUAL
}

enum ReconciliationOverrideDecisionKind {
  MATCHED
  UNMATCHED
}

enum ReconciliationProjectionStatus {
  UNMATCHED
  AMBIGUOUS
  MATCHED
  PARTIALLY_RECONCILED
  FULLY_RECONCILED
}

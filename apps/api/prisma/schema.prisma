  externalWritePerformed    Boolean  @default(false)
  autoSubmitAllowed         Boolean  @default(false)
  resultDigest              String
  computedAt                DateTime
  createdAt                 DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, disputeReference, resultDigest])
  @@index([organizationId, disputeReference, computedAt])
}

/// PC-01B（MSG-20261003-148/149）：邮箱验证令牌。库内只存 SHA-256 digest，明文 token 永不落库。
model EmailVerificationToken {
  id              String    @id @default(uuid())

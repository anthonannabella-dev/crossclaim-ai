  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  /// 整数微单位（1 USD = 1_000_000 micros；避免浮点误差）
  costMicros     Int      @default(0)
  latencyMs      Int      @default(0)
  result         String
  attemptNo      Int      @default(1)
  createdAt      DateTime @default(now())

  @@unique([callId])
  @@index([organizationId, createdAt])
  @@index([incidentId, createdAt])
  @@index([taskId, createdAt])
}

/// 分级预算**配置**（durable）：PLATFORM → ORGANIZATION → ACCOUNT → INCIDENT/TASK；子级只能收紧
/// 注意：usage 不在此表（AiBudgetUsage = FORBIDDEN）；用量永远由 AiCostLedgerEntry 聚合
model AiBudgetPolicy {
  id                     String        @id @default(uuid())
  scope                  AiBudgetScope
  /// PLATFORM='*'；其余为对应实体 id
  scopeRef               String
  /// 非 PLATFORM 必填；PLATFORM 用 '' 哨兵（保证同 scopeRef 跨 tenant 各自独立）
  organizationId         String        @default("")
  dailyLimitMicros       Int?
  monthlyLimitMicros     Int?
  perIncidentLimitMicros Int?
  strongCallLimit        Int?
  tokenLimit             Int?
  concurrencyLimit       Int?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([scope, scopeRef, organizationId])
  @@index([organizationId])
}

/// 确定性模型缓存（可丢弃派生数据；受控 TTL/GC；**非** append-only）
/// identity 列不可原地改写；organizationId='' 表示 platform 级（保证唯一键确定性）
model AiModelCacheEntry {
  id             String    @id @default(uuid())
  taskType       String
  promptDigest   String
  inputDigest    String
  ruleVersion    String
  schemaVersion  String
  capabilityTier String
  organizationId String    @default("")
  resultDigest   String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastServedAt   DateTime?

  @@unique([taskType, promptDigest, inputDigest, ruleVersion, schemaVersion, capabilityTier, organizationId])
  @@index([organizationId, expiresAt])
  @@index([expiresAt])
}

// ============================================================
// P6-PROD-U1（HOST AUTHORIZATION 2026-10-06）—— Controlled Config Execution Durability
// 生产级**耐久执行底座**（reservation / ownership / lease / 状态机 / append-only 事件 /
// 终态结果 / transactional outbox / 消费者交付账本）。
// 边界：NO PRODUCTION ENABLEMENT —— environment 只允许 SANDBOX，production mutation switch 保持 false；
//   平台级模型（无 organizationId / tenantId / customerId），与 RSI 平台级自治表同一治理口径。
// 本组表不构成第二个 runtime / 第二个控制面：只承载受控配置执行的耐久状态与证据。
// ============================================================

/// durable reservation / execution ownership —— 一次授权最多一次 committed mutation 的耐久身份
/// 可变列仅限 status / lease / attempt / terminal 指针；identity 与 immutable basis 由触发器冻结。
model ControlledConfigExecutionReservation {
  id                          String   @id @default(uuid())
  /// 确定性 reservation 身份（verdict + ticket + plan + executionMode 的摘要）
  reservationKey              String   @unique
  /// 不可变执行依据摘要（lease 之前冻结；任何 basis 字段原地改动都会被触发器拒绝）
  immutableBasisDigest        String
  authorizationVerdictDigest  String   @unique
  authorizationTicketDigest   String   @unique
  planDigest                  String
  candidateDigest             String
  proposalDigest              String
  controlledAdoptionDigest    String
  rollbackPlanDigest          String
  baselineSnapshotDigest      String
  baselineConfigFingerprint   String
  /// recovery 依据：U2 authorization ticket 绑定的 liveConfigVersion（不可原地改写）
  preConfigVersion            String
  environment                 String   @default("SANDBOX")
  executionMode               String   @default("SANDBOX_WRITE_ONLY")
  target                      String
  configPath                  String
  fromValue                   String
  toValue                     String
  idempotencyKey              String   @unique
  /// 同 idempotencyKey 但不可变载荷不一致 → FAIL CLOSED（禁止 silent overwrite）
  idempotencyPayloadDigest    String
  status                      String   @default("RESERVED")
  executionAttempt            Int      @default(0)
  ownerRef                    String?
  leaseId                     String?
  leaseAcquiredAt             DateTime?
  leaseRenewedAt              DateTime?
  leaseExpiresAt              DateTime?
  reservationExpiresAt        DateTime
  reservedAt                  DateTime @default(now())
  startedAt                   DateTime?
  terminalAt                  DateTime?
  terminalCode                String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  events ControlledConfigExecutionEvent[]
  result ControlledConfigExecutionResult?
  outbox ControlledConfigExecutionOutbox[]

  @@index([status, leaseExpiresAt])
  @@index([status, reservationExpiresAt])
  @@index([environment, status])
}

/// append-only 事件历史 —— 执行证据不得被 UPDATE 覆盖成「最后一次状态」
model ControlledConfigExecutionEvent {
  id             String   @id @default(uuid())
  reservationId  String
  seq            Int
  kind           String
  fromStatus     String?
  toStatus       String?
  ownerRef       String?
  leaseId        String?
  evidenceDigest String?
  /// 结构化补充（JSON 文本；禁止凭据 / 客户敏感 payload / raw 模型输出）
  detail         String?
  occurredAt     DateTime @default(now())

  reservation ControlledConfigExecutionReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([reservationId, seq])
  @@index([reservationId, occurredAt])
}

/// append-only 终态结果证据（每次 reserve 至多一条；reservation 侧为唯一外键）
model ControlledConfigExecutionResult {
  id                    String   @id @default(uuid())
  reservationId         String   @unique
  executionId           String
  status                String
  resultCode            String
  semantics             String
  preConfigFingerprint  String
  preConfigVersion      String
  /// CAS 异常等 unknown-outcome 场景必须为 null（post-state UNKNOWN），不得回填 pre identity
  postConfigFingerprint String?
  postConfigVersion     String?
  idempotencyKey        String
  resultDigest          String
  provenanceDigest      String
  evidenceSource        String
  /// 由对账 / 恢复写入时记录的执行者（人工或 reconciliation worker）
  reconciledBy          String?
  recordedAt            DateTime @default(now())

  reservation ControlledConfigExecutionReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([status, recordedAt])
  @@index([resultCode, recordedAt])
}

/// transactional outbox —— 关闭「DB commit 成功但事件丢失」与「事件发出但状态未落库」两类窗口
model ControlledConfigExecutionOutbox {
  id               String   @id @default(uuid())
  reservationId    String
  topic            String
  /// 事件级幂等键（确定性；重复写入不产生第二条事件）
  eventKey         String   @unique
  payloadDigest    String
  /// 事件载荷（JSON 文本；禁止凭据 / 客户敏感 payload / raw 模型输出）
  payload          String
  createdAt        DateTime @default(now())
  dispatchedAt     DateTime?
  dispatchAttempts Int      @default(0)

  reservation ControlledConfigExecutionReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  deliveries  ControlledConfigExecutionDelivery[]

  @@index([dispatchedAt, createdAt])
  @@index([reservationId, createdAt])
}

/// append-only 消费者交付账本 —— 消费者幂等（同一 outbox 事件同一消费者至多一次）
model ControlledConfigExecutionDelivery {
  id            String   @id @default(uuid())
  outboxId      String
  consumerRef   String
  /// 交付级幂等键（确定性：outboxId + consumerRef）
  deliveryKey   String   @unique
  payloadDigest String
  consumedAt    DateTime @default(now())

  outbox ControlledConfigExecutionOutbox @relation(fields: [outboxId], references: [id], onDelete: Restrict)

  @@unique([outboxId, consumerRef])
  @@index([consumerRef, consumedAt])
}

// ============================================================
// PROVIDER FOLLOW-UP INTELLIGENCE / P1（HOST 2026-10-06 授权）—— Provider Submission Scheduler
// tenant-owned durable 队列 + append-only 调度证据 + durable provider-aware 限流窗口。
// 边界：transport 恒为 FALSE；本组表只承载「准备就绪 / 限流 / 等待 / 人工」决策，不发起任何真实平台写。
// ============================================================

/// durable provider submission 队列项（一次 intent 一条；同 org 幂等键唯一）
model ProviderSubmissionIntent {
  id                String   @id @default(uuid())
  organizationId    String
  platformAccountId String
  platform          String
  operation         String
  /// credential / connection lineage（平台账号连接身份，不是裸凭据）
  connectionRef     String
  caseRef           String?
  claimRef          String?
  idempotencyKey    String
  payloadDigest     String
  basisDigest       String
  /// 决策时使用的 provider policy 身份（审计用；策略缺失时不得派发）
  policyProfileId   String?
  priority          Int      @default(0)
  state             String   @default("QUEUED")
  attemptCount      Int      @default(0)
  availableAt       DateTime @default(now())
  retryAfterAt      DateTime?
  cooldownUntil     DateTime?
  lastOutcome       String?
  lastReason        String?
  ownerRef          String?
  leaseId           String?
  leaseAcquiredAt   DateTime?
  leaseExpiresAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events ProviderSubmissionEvent[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([state, availableAt])
  @@index([organizationId, platformAccountId, state])
  @@index([organizationId, platform, operation, state])
}

/// append-only 调度证据（决策 / lease / provider 响应分类 / 死信）
model ProviderSubmissionEvent {
  id                   String   @id @default(uuid())
  organizationId       String
  intentId             String
  seq                  Int
  kind                 String
  fromState            String?
  toState              String?
  decision             String?
  reason               String?
  providerResponseKind String?
  policyDigest         String?
  ownerRef             String?
  leaseId              String?
  detail               String?
  occurredAt           DateTime @default(now())

  intent ProviderSubmissionIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@unique([intentId, seq])
  @@unique([organizationId, id])
  @@index([organizationId, occurredAt])
}

/// durable provider-aware 限流窗口（account / operation / connection 维度；窗口即事实）
model ProviderRateWindow {
  id             String   @id @default(uuid())
  organizationId String
  /// 维度复合键（org|platform|account|operation|connection 的组合，由策略声明）
  scopeKey       String
  windowStart    DateTime
  windowMs       Int
  count          Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, scopeKey, windowStart])
  @@unique([organizationId, id])
  @@index([organizationId, scopeKey, windowStart])
}

// ============================================================
// PROVIDER FOLLOW-UP INTELLIGENCE / P3（HOST 2026-10-06 授权）—— Provider case / contact 事实层与投影
// tenant-owned：原始 provider 事实 append-only（不可改写、不可删除），canonical projection 仅由事实派生。
// 边界：本组只承载读取事实与派生投影；不含任何写平台能力、不存凭据。
// ============================================================

/// provider case 原始事实快照（append-only；同一快照重复写入 → 幂等复用）
model ProviderCaseFact {
  id                String   @id @default(uuid())
  organizationId    String
  platformAccountId String
  platform          String
  providerCaseId    String
  /// 归一化 case 快照的内容摘要（与 org/account/case 组成唯一键，保证同快照只落一条）
  factDigest        String
  status            String
  subject           String?
  providerCreatedAt DateTime?
  providerUpdatedAt DateTime?
  lastContactAt     DateTime?
  contactKinds      String
  attachmentCount   Int      @default(0)
  adapterId         String
  adapterVersion    String
  credentialRef     String
  connectionRef     String?
  fetchedAt         DateTime
  /// 归一化快照（JSON 文本；不含凭据内容）
  snapshot          String
  recordedAt        DateTime @default(now())

  @@unique([organizationId, platformAccountId, providerCaseId, factDigest])
  @@unique([organizationId, id])
  @@index([organizationId, platformAccountId, providerCaseId, recordedAt])
}

/// provider contact（case 沟通记录）原始事实（append-only）
model ProviderContactFact {
  id                String   @id @default(uuid())
  organizationId    String
  platformAccountId String
  platform          String
  providerCaseId    String
  contactId         String
  factDigest        String
  kind              String
  direction         String
  occurredAt        DateTime
  bodyText          String?
  bodyDigest        String?
  /// 附件引用数组的 JSON 文本（仅引用，不含内容）
  attachments       String
  attachmentCount   Int      @default(0)
  adapterId         String
  adapterVersion    String
  credentialRef     String
  connectionRef     String?
  fetchedAt         DateTime
  recordedAt        DateTime @default(now())

  @@unique([organizationId, platformAccountId, providerCaseId, contactId, factDigest])
  @@unique([organizationId, id])
  @@index([organizationId, platformAccountId, providerCaseId, occurredAt])
}

/// case 的 canonical projection（只由 append-only 事实派生；身份不可改写）
model ProviderCaseProjection {
  id                String   @id @default(uuid())
  organizationId    String
  platformAccountId String
  platform          String
  providerCaseId    String
  status            String
  subject           String?
  lastContactAt     DateTime?
  contactCount      Int      @default(0)
  attachmentCount   Int      @default(0)
  contactKinds      String
  /// 派生代数：每次事实推进 +1（历史由 append-only 事实保留）
  generation        Int      @default(0)
  lastFactDigest    String
  firstFactAt       DateTime
  lastFactAt        DateTime
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, platformAccountId, providerCaseId])
  @@unique([organizationId, id])
}

// ============================================================
// CHANGE B（MSG-20261003-141）— Independent-site Phase 1 结果的**持久化只读投影**。
//   · 把 Phase 1 的 qualification / evidence readiness / claim-ready 结果落成 append-only 事实，
//     使 `/independent-site-disputes/:ref/state` 能真实读出这些节点（不再是 notPersisted）。
//   · 只记录**只读投影**：不得表示外部执行（externalWritePerformed / autoSubmitAllowed 必须为 false，DB CHECK 强制）。
//   · latest 由 computedAt DESC, id DESC 推导；禁止 mutable isLatest。
// ============================================================
model IndependentSitePhase1Projection {
  id                        String   @id
  organizationId            String
  disputeReference          String
  policyId                  String
  policyVersion             String
  algorithmVersion          String
  qualificationStatus       String

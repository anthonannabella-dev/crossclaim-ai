  handoffReference  String
  attestedByActorId String
  executionKey      String
  contentDigest     String
  observedAt        DateTime
  createdAt         DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// initial recovery handoff root：每个 dispute 仅一条（并发 exactly-one）
  @@unique([organizationId, disputeReference])
  @@unique([organizationId, executionKey])
  @@unique([organizationId, contentDigest])
  @@index([organizationId, paymentAccountRef, observedAt])
}


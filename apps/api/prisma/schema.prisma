  entryFactId                        String
  policyId                           String
  policyVersion                      String
  algorithmVersion                   String
  inputDigest                        String
  resultDigest                       String
  status                             String
  qualificationStatus                String
  confirmedRecoverableAmountByCurrency Json
  eligibleQuantityByLine             Json
  reasonCodes                        Json
  payload                            Json
  computedAt                         DateTime
  createdAt                          DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryFact    CustomsEntryFactRecord @relation(fields: [entryFactId], references: [id], onDelete: Cascade)

  @@index([organizationId, entryFactId, computedAt])
}

// ============================================================

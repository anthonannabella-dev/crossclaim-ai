  ownerGateRequired Boolean  @default(false)
  dedupeKey         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  incident   AutonomyIncident    @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  candidates AutonomyCandidate[]
  lease      AutonomyLease?

  @@unique([dedupeKey])
  @@index([incidentId, status])
  @@index([status, createdAt])
}

model AutonomyCandidate {
  id            String   @id @default(uuid())

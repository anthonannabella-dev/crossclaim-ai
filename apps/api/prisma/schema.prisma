  estimatedExternalApiCost Decimal  @db.Decimal(38, 6)
  estimatedBrokerCost      Decimal  @db.Decimal(38, 6)
  expectedNetRecovery      Decimal  @db.Decimal(38, 6)
  costRatio                Decimal? @db.Decimal(38, 6)
  payload                  Json
  computedAt               DateTime
  createdAt                DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, platformAccountId, computedAt])
  @@index([organizationId, inputDigest])
}

// ============================================================
// P0-1（BUSINESS SURVIVAL GATE）收尾：Return/Export/Destruction → 匹配 → 证据包 的**已裁决**结果
//   · append-only：每次组装新增历史；latest 由 computedAt 推导（HTTP 只读该结果，不重算）
//   · confirmedRecoverableAmountByCurrency 只为 EXACT/PARTIAL 行计算；AMBIGUOUS / NO_MATCH / 
//     RECONCILIATION_REQUIRED 一律零计入，且不得进入 claim-ready 状态
// ============================================================
model CustomsReturnClaimEvidenceRecord {

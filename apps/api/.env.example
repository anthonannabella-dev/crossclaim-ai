# CrossClaim API — 环境变量模板
# 复制为 .env 后填写。**不要把真实 .env 提交进仓库。**

# 数据库（PostgreSQL 16）
DATABASE_URL="postgresql://crossclaim:CHANGE_ME@localhost:5432/crossclaim"

# 对象存储（S3 兼容；本地开发可用 SeaweedFS / MinIO）
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_BUCKET="crossclaim"
# 凭据只写"引用名"，实际值放密钥管理，不要写在这里
S3_ACCESS_KEY_REF=""
S3_SECRET_KEY_REF=""

# 存储适配层（C-0003 / Gate 1）
# local = 本机磁盘（开发 / CI，无对象存储也能跑通）；s3 = S3 兼容对象存储
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".storage"
STORAGE_PUBLIC_BASE_URL="http://localhost:3000"
# 签名下载令牌密钥：真实值放密钥管理；仓库里只留占位
STORAGE_URL_SECRET=""
STORAGE_SIGNED_URL_TTL_SECONDS="300"

# Temporal（长期工作流）
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"

# AI 服务（apps/ai）
AI_SERVICE_URL="http://localhost:8003"
# 模型密钥同样只写引用名
DEEPSEEK_API_KEY_REF=""

# 运行时
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

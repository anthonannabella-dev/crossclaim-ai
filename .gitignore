# ============================================================
# CrossClaim AI · .gitignore
# ============================================================

# ----- 密钥/环境变量（务必忽略）-----
.env
.env.*
!.env.example
*.env
*_credentials
*_secret
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# ----- 依赖 -----
node_modules/
**/node_modules/
.pnp
.pnp.js

# ----- Python -----
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# ----- 构建产物 -----
dist/
build/
.next/
out/
*.tsbuildinfo

# ----- Prisma -----
**/.prisma/
*.db
*.db-journal

# ----- 日志与运行时 -----
logs/
*.log
npm-debug.log*
*.pid
.cache/
tmp/
temp/
coverage/

# ----- 本地数据与上传 -----
uploads/
/storage/
/.storage/
apps/api/.storage/
data/local/

# ----- 编辑器/系统 -----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ----- 备份与临时文件（禁止把交付包痕迹带进正式工程）-----
*bak
*.bak_*
*.orig
*.rej
_tmp_*
.trash_*/

# ----- Agent bridge 运行时状态 -----
tools/agent-bridge/.state/

# ----- 许可证闸门产物 -----
tools/license-gate/report.json

# ----- C-0013-B 连接器运行时产物（游标 / 隔离区不进仓库）-----
reports/cursors/
reports/quarantine/

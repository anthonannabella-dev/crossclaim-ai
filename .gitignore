# ============================================================
# CrossClaim AI · .gitignore
# ============================================================

# ----- 密钥/环境变量（务必忽略）-----
.env
.env.*
!.env.example
*.env
*_credentials
*_secret
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# ----- 依赖 -----
node_modules/
**/node_modules/
.pnp
.pnp.js

# ----- Python -----
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# ----- 构建产物 -----
dist/
build/
.next/
out/
*.tsbuildinfo

# ----- Prisma -----
**/.prisma/
*.db
*.db-journal

# ----- 日志与运行时 -----
logs/
*.log
npm-debug.log*
*.pid
.cache/
tmp/
temp/
coverage/

# ----- 本地数据与上传 -----
uploads/
/storage/
/.storage/
apps/api/.storage/
data/local/

# ----- 编辑器/系统 -----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ----- 备份与临时文件（禁止把交付包痕迹带进正式工程）-----
*bak
*.bak_*
*.orig
*.rej
_tmp_*
.trash_*/

# ----- Agent bridge 运行时状态 -----
tools/agent-bridge/.state/

# ----- 许可证闸门产物 -----
tools/license-gate/report.json

# ----- C-0013-B 连接器运行时产物（游标 / 隔离区不进仓库）-----
reports/cursors/
reports/quarantine/

# Phase 1 真实/脱敏数据投放目录：数据不入库（仅保留 README）
inbox/*
!inbox/README.md


# 运行时本地存储（E1/E2 采集用，勿入库）
.runtime-storage/

# ----- AUTOPILOT 运行态（liveness / lock；非交付物）-----
.autopilot/HEARTBEAT.json
.autopilot/RUNNER.lock
.autopilot/PIPELINE.lock
.autopilot/units-materialized/*.tmp
.ui-check/
+
+# SI/RSI 连续执行运行时产物（由 Windows 计划任务每 180 秒重新生成；不进入版本库以免污染工作树）
+tools/dev/logs/
+tools/dev/*.flag
+tools/dev/.continuous-check.lock
+tools/dev/continuous-execution-state.json

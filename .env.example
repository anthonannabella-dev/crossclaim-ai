# ============================================================
# 出口报关合规AI SaaS - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# --- Node ---
NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=customs
POSTGRES_PASSWORD=***

# --- Redis ---
REDIS_PASSWORD=***

# --- MinIO ---
MINIO_ENDPOINT=seaweedfs
MINIO_PORT=8333
MINIO_ACCESS_KEY=admin
MINIO_PASSWORD=***

# --- JWT (generate with: openssl rand -base64 48) ---
JWT_SECRET=***

# --- Public Host & URLs ---
PUBLIC_HOST=your-domain.com
BASE_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# --- CORS ---
CORS_ORIGIN=https://your-domain.com

# --- DeepSeek AI ---
DEEPSEEK_API_KEY=***

# --- Activepieces ---
AP_JWT_SECRET=***

# --- OCR Service ---
OCR_SERVICE_URL=http://ocr:8002

# --- WeChat Pay ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=***
WECHAT_MCH_ID=
WECHAT_API_KEY=***
WECHAT_API_V3_KEY=

# --- Alipay ---
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# --- Notification Channels ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=***
FEISHU_WEBHOOK_URL=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=***
DINGTALK_WEBHOOK_URL=
WECOM_WEBHOOK_URL=

# --- SMTP (password reset & email verification) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@customs-saas.com

# ========== SMS (optional - pick one provider) ==========
# If none configured, verification codes go to debug log only

# --- Aliyun SMS ---
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_ACCESS_SECRET=***
ALIYUN_SMS_SIGN=***
ALIYUN_SMS_TEMPLATE=

# --- Tencent SMS ---
TENCENT_SMS_SECRET_ID=***
TENCENT_SMS_SECRET_KEY=***
TENCENT_SMS_SIGN=***
TENCENT_SMS_TEMPLATE=
TENCENT_SMS_APP_ID=

# --- Frontend URLs ---
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ========== 报关单 XML 导出 / 海关代码表 ==========
# 全量海关代码表(监管方式/国别/计量单位等)。不填则自动加载随镜像打包的
# data/customsCodes.generated.json(开箱即用);如需用自己整理的官方全表,
# 指向该 JSON 文件路径即可(键名见 XML代码映射说明.md)。
CUSTOMS_CODE_TABLE_PATH=
# 严格代码卡口:1=映射不到海关代码的字段在预检阶段报 error 阻断导出;
# 留空/0=仅 warning 提示不阻断(默认)。正式上线建议设 1。
STRICT_CUSTOMS_CODES=
# 导出报文最外层根节点(默认 DecMessage);按你对接的单一窗口客户端要求填,
# 例如 CEB 跨境电商报文填 CEB311Message。内部 DecHead/DecLists 字段不受影响。
CUSTOMS_XML_ROOT=
# 根节点属性,如命名空间;例:xmlns="http://www.chinaport.gov.cn/ceb"
CUSTOMS_XML_ROOT_ATTRS=
# 外层信封节点名(可选);设了才会输出 <信封><根>...</根></信封>。
CUSTOMS_XML_ENVELOPE=

# ========== 报关单 XML 导出 / 海关代码表 ==========
